p3","dur":22.39,"text":"Leopold tried to fly to see farther. He flapped his wings, once, twice. But his long tail was heavy, so heavy! He rose no higher than the hedge. Then Pipo the sparrow came down from his branch. “I can help, if you like,” he said very gently. And hop! He flew up high, above the trees.","words":[0.12,0.895,1.145,1.245,1.545,1.67,1.895,2.88,3.045,3.37,3.545,4.195,4.52,5.61,5.78,5.955,6.28,6.555,6.73,7.355,7.605,8.61,8.73,9.08,9.305,9.63,9.73,9.83,10.905,11.155,11.78,11.88,12.28,12.53,12.83,12.955,13.13,14.26,14.45,14.65,15.05,15.175,15.275,16.075,16.25,16.5,16.825,18.05,18.275,19.555,19.755,19.98,20.205,20.755,21.08,21.205],"visemes":[[0.0,"smile"],[0.17,"grin"],[0.22,"smile"],[0.32,"grin"],[0.47,"small"],[0.545,"smile"],[0.62,"o"],[0.695,"grin"],[0.995,"smile"],[1.07,"open"],[1.12,"grin"],[1.37,"smile"],[1.47,"open"],[1.57,"grin"],[1.92,"small"],[2.02,"grin"],[2.385,"smile"],[2.895,"grin"],[3.17,"smile"],[3.295,"small"],[3.345,"grin"],[3.62,"smile"],[3.72,"grin"],[4.12,"smile"],[4.22,"o"],[4.295,"open"],[4.345,"grin"],[4.47,"smile"],[4.545,"grin"],[4.595,"smile"],[4.77,"open"],[4.92,"grin"],[5.115,"smile"],[5.805,"grin"],[6.03,"smile"],[6.13,"o"],[6.205,"grin"],[6.355,"smile"],[6.43,"grin"],[6.88,"small"],[6.955,"grin"],[7.18,"smile"],[7.505,"o"],[7.63,"grin"],[7.755,"small"],[7.855,"grin"],[8.085,"smile"],[8.605,"grin"],[8.805,"smile"],[8.88,"o"],[8.98,"grin"],[9.155,"smile"],[9.23,"o"],[9.33,"grin"],[9.38,"smile"],[9.48,"grin"],[9.905,"smile"],[10.03,"grin"],[10.395,"smile"],[10.93,"grin"],[11.18,"small"],[11.28,"grin"],[11.38,"small"],[11.505,"o"],[11.805,"grin"],[11.955,"small"],[12.055,"grin"],[12.205,"o"],[12.305,"grin"],[12.455,"small"],[12.555,"grin"],[12.605,"smile"],[12.705,"grin"],[12.93,"small"],[12.98,"grin"],[13.155,"small"],[13.205,"smile"],[13.38,"open"],[13.455,"grin"],[13.745,"smile"],[14.375,"open"],[14.575,"grin"],[14.95,"small"],[15.025,"smile"],[15.075,"small"],[15.225,"o"],[15.3,"grin"],[15.35,"smile"],[15.475,"open"],[15