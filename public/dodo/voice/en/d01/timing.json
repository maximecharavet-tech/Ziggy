{"v":2,"voice":"ziggy-v2","locale":"en","story":"d01","segments":{"title":{"file":"title.mp3","dur":2.71,"text":"The Little Cloud Who Wanted to Help","words":[0.105,0.255,0.63,1.18,1.305,1.605,1.755],"visemes":[[0.0,"smile"],[0.13,"grin"],[0.83,"smile"],[1.005,"open"],[1.105,"grin"],[1.255,"o"],[1.405,"grin"],[1.83,"smile"],[1.905,"grin"],[2.13,"small"],[2.235,"smile"]]},"s1":{"file":"s1.mp3","dur":21.68,"text":"High up in the sky, above a quiet valley, floats a little white cloud. His name is Plume. He is round, light and very soft, like a cotton pillow. Every day, Plume drifts along with the wind. He watches the houses, the rivers and the birds. And every day, he wonders: “Could I help someone too?”","words":[0.12,0.365,0.515,0.59,0.69,1.34,1.59,1.665,2.115,2.94,3.215,3.29,3.54,3.84,4.97,5.17,5.47,5.645,6.68,6.845,7.02,7.77,8.12,8.245,8.595,9.145,9.27,9.345,9.695,10.69,11.0,11.55,11.925,12.275,12.55,12.65,12.75,13.72,13.91,14.36,14.46,15.385,15.535,16.01,16.11,16.21,17.445,17.67,18.045,18.545,18.72,19.795,19.92,20.07,20.345,20.72],"visemes":[[0.0,"smile"],[0.315,"open"],[0.49,"grin"],[0.84,"smile"],[1.04,"open"],[1.24,"smile"],[1.415,"small"],[1.515,"open"],[1.565,"small"],[1.615,"open"],[1.69,"grin"],[1.765,"o"],[1.815,"smile"],[1.915,"open"],[2.015,"grin"],[2.19,"smile"],[2.29,"grin"],[2.74,"smile"],[2.965,"small"],[3.015,"grin"],[3.09,"o"],[3.14,"grin"],[3.24,"open"],[3.315,"grin"],[3.615,"smile"],[3.69,"open"],[3.765,"grin"],[3.965,"smile"],[4.14,"open"],[4.265,"grin"],[4.355,"smile"],[4.995,"grin"],[5.245,"smile"],[5.395,"small"],[5.495,"grin"],[5.67,"small"],[5.745,"grin"],[5.795,"smile"],[5.92,"o"],[6.045,"small"],[6.185,"smile"],[6.695,"grin"],[7.095,"smile"],[7.245,"open"],[7.37,"grin"],[7.595,"smile"],[7.945,"open"],[8.045,"grin"],[8.27,"small"],[8.345,"grin"],[8.67,"smile"],[8.82,"o"],[8.92,"small"],[8.995,"grin"],[9.07,"smile"],[9.245,"grin"],[9.295,"open"],[9.37,"grin"],[9.445,"smile"],[9.52,"open"],[9.57,"grin"],[9.72,"small"],[9.82,"grin"],[10.07,"o