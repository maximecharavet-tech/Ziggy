 there are none left for me,” he said softly. He wasn’t upset. He was thinking of all the children sleeping with a smile. But he yawned, and he wondered what dream he would have tonight, without his little jar.","words":[0.1,0.19,0.34,0.515,0.59,0.69,0.965,1.74,2.215,2.415,2.49,2.665,3.73,3.825,4.05,5.19,5.36,5.51,5.86,6.285,6.56,7.565,7.965,8.115,8.24,8.465,8.74,8.865,9.42,9.56,9.835,11.07,11.27,11.545,12.7,12.76,12.935,13.285,13.485,13.71,13.885,14.385,14.885,15.01,15.135,16.29,16.38,16.605,17.48,17.58,17.755,18.155,18.43,18.88,19.03,19.155,19.48,20.38,20.78,20.98,21.28],"visemes":[[0.0,"smile"],[0.14,"grin"],[0.765,"smile"],[0.865,"open"],[0.915,"grin"],[1.14,"smile"],[1.215,"grin"],[1.565,"smile"],[1.765,"grin"],[1.965,"smile"],[2.04,"grin"],[2.14,"small"],[2.24,"grin"],[2.74,"smile"],[2.815,"open"],[2.89,"grin"],[3.115,"smile"],[3.775,"grin"],[4.175,"small"],[4.325,"grin"],[4.695,"smile"],[5.21,"grin"],[5.385,"open"],[5.535,"grin"],[5.985,"smile"],[6.06,"o"],[6.16,"grin"],[6.36,"smile"],[6.435,"grin"],[6.635,"smile"],[6.76,"grin"],[6.86,"small"],[6.96,"grin"],[7.055,"smile"],[7.715,"grin"],[7.89,"smile"],[7.99,"grin"],[8.89,"small"],[8.94,"smile"],[9.015,"grin"],[9.205,"smile"],[9.435,"grin"],[9.91,"smile"],[10.06,"small"],[10.11,"grin"],[10.435,"smile"],[11.095,"grin"],[11.295,"o"],[11.37,"open"],[11.42,"grin"],[11.595,"open"],[11.645,"small"],[11.77,"grin"],[11.845,"smile"],[11.97,"grin"],[12.205,"smile"],[12.685,"grin"],[13.36,"small"],[13.51,"smile"],[13.585,"o"],[13.66,"grin"],[14.66,"small"],[14.76,"grin"],[15.035,"open"],[15.16,"grin"],[15.235,"small"],[15.285,"smile"],[15.435,"open"],[15.56,"grin"],[15.645,"smile"],[16.255,"small"],[16.305,"grin"],[16.705,"smile"],[16.88,"o"],[17.005,"grin"],[17.38,"smile"],[17.505,"grin"],[17.78,"o"],[17.855,"grin"],[18.18,"o"],[18.255,"open"],[18.305,"grin"],[18.58,"smile"],[18.705,"grin"],[18.805,"small"],[18.905,"grin"],[19.055,"o"],[19.105,"grin"],[19.28,"open"],[19.355,"small"],[19.505,"grin"],[19.705,"smile"],[19