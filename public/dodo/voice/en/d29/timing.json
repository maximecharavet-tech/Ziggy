{"v":2,"voice":"ziggy-v2","locale":"en","story":"d29","segments":{"title":{"file":"title.mp3","dur":2.25,"text":"The Caterpillar in a Hurry","words":[0.105,0.255,1.03,1.105,1.23],"visemes":[[0.0,"smile"],[0.13,"grin"],[0.355,"smile"],[0.455,"grin"],[0.63,"small"],[0.73,"grin"],[1.13,"open"],[1.255,"grin"],[1.305,"smile"],[1.38,"grin"],[1.775,"smile"]]},"s1":{"file":"s1.mp3","dur":21.83,"text":"In a garden full of clover and daisies lived a little green caterpillar named Zelie. She had quick little feet and big curious eyes. Every morning, she watched the butterflies dance above the flowers. Blue ones, yellow ones, orange ones… “One day, I’ll be like them,” she said. “But I wish it could be today!”","words":[0.1,0.19,0.265,0.74,0.965,1.14,1.715,1.84,2.94,3.265,3.34,3.64,4.065,4.69,4.99,5.98,6.085,6.285,6.51,6.785,7.31,7.435,7.66,8.11,9.05,9.325,10.15,10.325,10.75,10.85,11.525,11.875,12.15,12.275,13.41,13.605,14.255,14.605,14.98,15.33,16.64,16.91,17.335,17.46,17.61,17.86,18.44,18.68,19.725,19.85,20.025,20.325,20.45,20.65,20.85],"visemes":[[0.0,"smile"],[0.115,"grin"],[0.215,"open"],[0.29,"grin"],[0.34,"smile"],[0.415,"open"],[0.465,"grin"],[0.765,"small"],[0.84,"o"],[0.89,"grin"],[0.99,"open"],[1.04,"small"],[1.165,"grin"],[1.29,"smile"],[1.39,"o"],[1.49,"grin"],[1.915,"smile"],[2.04,"grin"],[2.815,"smile"],[2.965,"grin"],[3.015,"smile"],[3.115,"open"],[3.24,"grin"],[3.29,"open"],[3.365,"grin"],[3.765,"smile"],[3.865,"grin"],[4.14,"smile"],[4.24,"grin"],[4.39,"small"],[4.465,"grin"],[4.765,"smile"],[4.89,"grin"],[5.215,"smile"],[5.34,"grin"],[5.465,"smile"],[6.01,"grin"],[6.36,"o"],[6.41,"grin"],[6.86,"smile"],[6.96,"grin"],[7.46,"small"],[7.535,"grin"],[7.785,"o"],[7.835,"grin"],[8.135,"smile"],[8.285,"open"],[8.41,"grin"],[8.555,"smile"],[9.1,"grin"],[9.35,"small"],[9.425,"o"],[9.475,"grin"],[10.0,"smile"],[10.175,"grin"],[10.35,"o"],[10.4,"smile"],[10.5,"open"],[10.6,"grin"],[10.875,"small"],[10.95,"open"],[11.0,"grin"],[11.125,"small"],[11.175,"smile"],[11.325,"op