ig blanket.","words":[0.105,0.505,0.83,1.005,1.355,1.68,2.795,3.87,3.97,4.095,4.245,4.72,4.97,5.07,5.32,5.695,5.82,6.74,6.86,7.11,7.435,7.56,8.67,8.79,9.14,9.465,9.59,10.66,10.75,11.1,11.425,11.55,12.645,12.82,13.045,13.695,13.92,14.02,14.095,14.595,14.82,15.57,15.82,15.945,16.145,17.11,17.42,17.745,17.845,18.095,19.26,19.48,19.705,20.005,20.08,20.205,20.53],"visemes":[[0.0,"smile"],[0.13,"grin"],[0.23,"smile"],[0.305,"open"],[0.355,"grin"],[0.58,"o"],[0.655,"small"],[0.755,"grin"],[1.03,"smile"],[1.13,"o"],[1.23,"grin"],[1.38,"o"],[1.48,"grin"],[1.78,"smile"],[1.905,"grin"],[2.285,"smile"],[2.82,"grin"],[3.17,"smile"],[3.37,"open"],[3.52,"grin"],[3.77,"smile"],[3.895,"grin"],[4.12,"open"],[4.27,"small"],[4.345,"grin"],[4.795,"smile"],[4.895,"grin"],[5.02,"small"],[5.095,"grin"],[5.445,"o"],[5.52,"grin"],[5.745,"small"],[5.845,"smile"],[5.995,"o"],[6.145,"grin"],[6.245,"smile"],[6.76,"open"],[6.885,"grin"],[7.235,"o"],[7.31,"grin"],[7.66,"smile"],[7.86,"open"],[8.01,"grin"],[8.175,"smile"],[8.69,"open"],[8.815,"grin"],[9.065,"o"],[9.165,"grin"],[9.265,"o"],[9.34,"grin"],[9.615,"small"],[9.665,"smile"],[9.815,"open"],[9.965,"small"],[10.165,"smile"],[10.675,"open"],[10.775,"grin"],[10.875,"smile"],[10.95,"grin"],[11.225,"o"],[11.3,"grin"],[11.8,"smile"],[11.9,"o"],[12.135,"smile"],[12.72,"grin"],[13.545,"smile"],[13.72,"grin"],[14.045,"open"],[14.12,"small"],[14.17,"smile"],[14.295,"grin"],[14.52,"o"],[14.62,"small"],[14.67,"grin"],[14.745,"o"],[14.845,"grin"],[14.995,"smile"],[15.07,"grin"],[15.42,"smile"],[15.595,"grin"],[16.02,"o"],[16.095,"smile"],[16.17,"grin"],[16.595,"smile"],[17.145,"grin"],[17.62,"o"],[17.67,"grin"],[17.87,"small"],[17.92,"grin"],[18.02,"o"],[18.17,"smile"],[18.245,"o"],[18.37,"grin"],[18.595,"smile"],[19.33,"grin"],[19.53,"open"],[19.58,"grin"],[19.73,"small"],[19.805,"smile"],[19.88,"open"],[19.93,"grin"],[20.055,"small"],[20.105,"grin"],[20.28,"smile"],[20.355,"grin"],[20.555,"small"],[20.63,"grin"],[20.68,"smile"],[20.755,"open"],[20.805