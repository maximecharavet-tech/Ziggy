{"v":2,"voice":"ziggy-v2","locale":"en","story":"d11","segments":{"title":{"file":"title.mp3","dur":2.32,"text":"The Whale Who Sang Softly","words":[0.1,0.27,0.57,0.745,1.17],"visemes":[[0.0,"smile"],[0.12,"grin"],[0.295,"o"],[0.345,"smile"],[0.445,"grin"],[0.645,"o"],[0.77,"grin"],[0.845,"smile"],[0.945,"open"],[1.02,"grin"],[1.27,"smile"],[1.37,"o"],[1.445,"small"],[1.52,"grin"],[1.845,"smile"]]},"s1":{"file":"s1.mp3","dur":22.83,"text":"Deep down in the sea, where the water is blue and soft, lived a little orange fish called Tiko. Tiko loved to swim among the dancing seaweed. Every evening, the moon laid a long silver trail on the water. And every evening, Tiko heard a faraway song. A very soft song, a very gentle song… and a little bit sad.","words":[0.12,0.415,0.665,0.74,0.915,1.565,1.69,1.84,2.24,2.44,2.815,2.99,3.94,4.265,4.34,4.64,5.115,5.49,5.815,6.85,7.4,7.725,7.875,8.2,8.425,8.525,9.05,10.1,10.375,11.125,11.275,11.625,11.825,11.975,12.425,12.8,13.15,13.25,13.35,14.29,14.425,14.725,15.5,15.95,16.15,16.3,16.8,17.89,18.015,18.465,18.89,19.715,19.84,20.24,20.765,21.315,21.415,21.465,21.665,21.915],"visemes":[[0.0,"smile"],[0.165,"grin"],[0.34,"small"],[0.44,"grin"],[0.49,"smile"],[0.59,"open"],[0.64,"grin"],[0.99,"smile"],[1.14,"grin"],[1.44,"smile"],[1.59,"o"],[1.64,"grin"],[1.915,"smile"],[2.015,"o"],[2.065,"grin"],[2.465,"small"],[2.54,"smile"],[2.69,"o"],[2.84,"grin"],[3.065,"smile"],[3.215,"o"],[3.315,"small"],[3.415,"grin"],[3.765,"smile"],[4.115,"open"],[4.365,"grin"],[4.665,"smile"],[4.74,"grin"],[5.19,"smile"],[5.29,"grin"],[6.19,"o"],[6.355,"smile"],[6.85,"grin"],[7.2,"o"],[7.475,"smile"],[7.6,"grin"],[7.975,"o"],[8.125,"small"],[8.225,"grin"],[8.275,"small"],[8.35,"open"],[8.4,"grin"],[8.6,"smile"],[8.7,"grin"],[9.125,"smile"],[9.2,"grin"],[9.275,"o"],[9.325,"smile"],[9.425,"grin"],[9.605,"smile"],[10.15,"grin"],[10.4,"smile"],[10.475,"grin"],[10.525,"small"],[10.575,"grin"],[11.025,"smile"],[11.15,"grin"],[11.35,"smile"],[11.45,"o"],[11.55,"grin"]