 wild strawberry. A blackbird sings him a pretty song. An autumn leaf falls on his head and tickles him. Gaspard laughs. “Thank you, mouse! Thank you, blackbird! Thank you, little leaf!” And the more he says thank you, the more lovely things he notices around him.","words":[0.1,0.41,0.51,1.335,1.435,1.785,1.985,2.135,2.26,2.635,3.84,3.92,4.57,4.82,4.945,5.02,5.32,6.32,6.49,6.84,7.24,7.565,7.69,7.865,8.44,8.565,8.915,9.85,10.4,11.52,11.915,12.09,13.15,13.48,13.68,15.03,15.37,15.595,15.82,17.05,17.165,17.29,17.665,17.865,18.215,18.59,19.365,19.49,19.815,20.365,20.765,20.94,21.565,21.965],"visemes":[[0.0,"smile"],[0.11,"grin"],[0.235,"smile"],[0.31,"o"],[0.36,"grin"],[0.535,"small"],[0.61,"smile"],[0.785,"open"],[0.935,"grin"],[1.235,"smile"],[1.36,"open"],[1.46,"small"],[1.51,"smile"],[1.61,"open"],[1.71,"grin"],[1.91,"small"],[1.96,"grin"],[2.085,"small"],[2.16,"open"],[2.285,"o"],[2.335,"smile"],[2.435,"open"],[2.51,"grin"],[2.81,"smile"],[2.885,"o"],[2.935,"small"],[3.035,"grin"],[3.345,"smile"],[3.845,"open"],[4.045,"smile"],[4.195,"grin"],[4.27,"small"],[4.37,"grin"],[4.92,"small"],[4.97,"open"],[5.045,"small"],[5.095,"grin"],[5.395,"smile"],[5.545,"o"],[5.695,"grin"],[5.825,"smile"],[6.365,"grin"],[6.515,"smile"],[6.615,"grin"],[6.765,"small"],[6.865,"smile"],[7.015,"grin"],[7.115,"small"],[7.315,"smile"],[7.415,"o"],[7.49,"grin"],[7.94,"smile"],[8.04,"grin"],[9.115,"small"],[9.215,"smile"],[9.875,"grin"],[9.975,"open"],[10.075,"grin"],[10.175,"small"],[10.275,"open"],[10.325,"grin"],[10.475,"smile"],[10.625,"open"],[10.725,"small"],[10.825,"grin"],[11.005,"smile"],[11.615,"grin"],[11.665,"smile"],[11.74,"open"],[11.79,"grin"],[11.99,"o"],[12.04,"smile"],[12.115,"small"],[12.165,"smile"],[12.265,"open"],[12.39,"grin"],[12.605,"smile"],[13.205,"grin"],[13.305,"open"],[13.355,"grin"],[13.555,"o"],[13.63,"smile"],[13.755,"grin"],[13.805,"smile"],[13.88,"open"],[13.93,"grin"],[14.005,"small"],[14.105,"grin"],[14.485,"smile"],[15.095,"grin"],[15.195,"open"],[15.245,"