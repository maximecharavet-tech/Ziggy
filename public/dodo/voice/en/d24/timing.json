ako had never laughed at him. Not even once.","words":[0.115,0.59,0.84,1.09,1.515,2.345,2.52,3.22,3.345,3.57,4.785,4.96,5.185,5.41,5.71,5.91,6.95,7.095,7.32,7.445,7.57,8.74,8.88,9.105,9.23,9.405,9.755,10.85,11.18,11.43,11.555,12.48,12.585,12.76,13.185,13.31,13.46,13.685,14.72,14.865,15.065,15.265,15.44,15.59,16.53,16.945,17.17,17.245,17.42,18.585,19.16,19.36,19.66,20.01,20.085,21.15,21.46,21.785],"visemes":[[0.0,"smile"],[0.29,"open"],[0.365,"grin"],[0.465,"o"],[0.615,"grin"],[0.665,"smile"],[0.74,"open"],[0.79,"grin"],[0.915,"smile"],[1.015,"open"],[1.065,"grin"],[1.315,"smile"],[1.44,"open"],[1.49,"grin"],[1.715,"small"],[1.845,"smile"],[2.445,"grin"],[2.645,"smile"],[2.745,"grin"],[3.12,"smile"],[3.245,"grin"],[3.645,"o"],[3.745,"grin"],[3.845,"smile"],[3.995,"grin"],[4.275,"smile"],[4.885,"open"],[5.035,"smile"],[5.11,"o"],[5.21,"grin"],[5.735,"small"],[5.835,"open"],[5.985,"smile"],[6.06,"open"],[6.135,"grin"],[6.455,"smile"],[7.02,"open"],[7.17,"smile"],[7.245,"o"],[7.395,"grin"],[7.745,"smile"],[7.87,"o"],[7.995,"grin"],[8.245,"smile"],[8.755,"grin"],[9.48,"smile"],[9.58,"o"],[9.655,"grin"],[9.83,"smile"],[9.955,"grin"],[10.335,"smile"],[10.88,"grin"],[10.98,"o"],[11.055,"grin"],[11.205,"smile"],[11.305,"grin"],[11.58,"small"],[11.63,"smile"],[11.705,"grin"],[11.985,"smile"],[12.46,"small"],[12.56,"grin"],[12.785,"small"],[12.86,"smile"],[13.01,"o"],[13.135,"grin"],[13.21,"o"],[13.26,"grin"],[13.385,"open"],[13.485,"small"],[13.585,"o"],[13.635,"grin"],[13.71,"small"],[13.76,"smile"],[13.91,"open"],[14.06,"grin"],[14.225,"smile"],[14.79,"open"],[14.89,"o"],[14.99,"grin"],[15.365,"o"],[15.465,"small"],[15.615,"grin"],[15.715,"o"],[16.035,"smile"],[16.52,"small"],[16.595,"grin"],[16.745,"smile"],[16.82,"o"],[16.97,"grin"],[17.045,"o"],[17.095,"grin"],[17.445,"small"],[17.495,"grin"],[17.545,"smile"],[17.645,"grin"],[18.075,"smile"],[18.61,"small"],[18.66,"smile"],[18.76,"open"],[18.86,"grin"],[19.01,"o"],[19.235,"open"],[19.285,"grin"],[19.51,"small"],[19.56,"g