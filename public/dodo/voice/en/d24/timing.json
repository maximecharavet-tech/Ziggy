{"v":2,"voice":"ziggy-v3","locale":"en","story":"d24","segments":{"title":{"file":"title.mp3","dur":2.51,"text":"The Kitten and the Vine Bridge","words":[0.115,0.265,0.74,0.84,0.965,1.39],"visemes":[[0.0,"smile"],[0.14,"grin"],[0.365,"smile"],[0.44,"grin"],[0.99,"small"],[1.065,"smile"],[1.165,"open"],[1.265,"grin"],[1.415,"small"],[1.49,"smile"],[1.64,"grin"],[2.035,"smile"]]},"s1":{"file":"s1.mp3","dur":21.84,"text":"In a warm green forest, between two tall trees, there was a vine bridge. It swayed gently above a singing stream. On one side lived Pilou, a little striped kitten. On the other side lived his friend Bako, a little monkey with big ears. Every day, Bako hopped across the bridge to come and play.","words":[0.1,0.215,0.365,0.765,1.14,1.865,2.265,2.515,2.84,3.815,3.94,4.065,4.19,4.565,5.64,5.83,6.33,6.805,7.055,7.18,7.53,8.58,8.75,8.975,9.275,9.6,10.45,10.5,10.725,11.125,12.2,12.29,12.44,12.765,13.265,13.59,13.765,14.09,15.165,15.265,15.54,16.04,16.24,16.49,17.79,18.1,18.775,19.275,19.55,19.9,20.0,20.4,20.525,20.725,20.85],"visemes":[[0.0,"smile"],[0.115,"grin"],[0.24,"open"],[0.39,"o"],[0.44,"smile"],[0.515,"o"],[0.59,"grin"],[0.665,"small"],[0.79,"grin"],[0.865,"smile"],[0.94,"grin"],[1.165,"small"],[1.215,"smile"],[1.315,"o"],[1.39,"grin"],[1.79,"smile"],[1.89,"grin"],[2.04,"o"],[2.115,"grin"],[2.34,"smile"],[2.415,"o"],[2.59,"smile"],[2.69,"o"],[2.765,"grin"],[2.965,"smile"],[3.09,"grin"],[3.715,"smile"],[3.84,"grin"],[4.09,"open"],[4.265,"smile"],[4.39,"open"],[4.49,"grin"],[4.69,"smile"],[4.79,"grin"],[5.145,"smile"],[5.68,"grin"],[5.98,"smile"],[6.105,"grin"],[6.88,"small"],[7.08,"open"],[7.205,"grin"],[7.705,"smile"],[7.805,"grin"],[7.955,"small"],[8.085,"smile"],[8.625,"o"],[8.675,"grin"],[8.775,"o"],[8.85,"grin"],[9.05,"smile"],[9.15,"open"],[9.2,"grin"],[9.35,"smile"],[9.425,"open"],[9.475,"grin"],[9.625,"small"],[9.675,"grin"],[9.825,"smile"],[9.95,"o"],[10.3,"smile"],[10.475,"grin"],[10.925,"open"],[10.975,"grin"],[11.2,"smile"],[11.275,"grin"