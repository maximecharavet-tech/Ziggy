end. Bako had never laughed at him. Not even once.","words":[0.115,0.59,0.84,1.09,1.515,2.29,2.455,3.03,3.155,3.38,4.41,4.565,4.79,4.99,5.29,5.465,6.4,6.545,6.77,6.895,7.02,8.08,8.22,8.445,8.57,8.745,9.095,10.065,10.39,10.64,10.765,11.57,11.675,11.85,12.275,12.4,12.55,12.775,13.74,13.885,14.085,14.285,14.46,14.61,15.47,15.87,16.095,16.17,16.345,17.375,17.95,18.15,18.45,18.8,18.875,19.82,20.12,20.445],"visemes":[[0.0,"smile"],[0.29,"open"],[0.365,"grin"],[0.465,"o"],[0.615,"grin"],[0.665,"smile"],[0.74,"open"],[0.79,"grin"],[0.915,"smile"],[1.015,"open"],[1.065,"grin"],[1.315,"smile"],[1.44,"open"],[1.49,"grin"],[1.69,"small"],[1.795,"smile"],[2.305,"grin"],[2.58,"smile"],[2.655,"grin"],[2.955,"smile"],[3.055,"grin"],[3.255,"open"],[3.305,"grin"],[3.455,"o"],[3.53,"grin"],[3.605,"smile"],[3.755,"grin"],[3.915,"smile"],[4.49,"open"],[4.64,"smile"],[4.715,"o"],[4.815,"grin"],[5.315,"small"],[5.39,"open"],[5.54,"smile"],[5.615,"grin"],[5.905,"smile"],[6.47,"open"],[6.62,"smile"],[6.695,"o"],[6.845,"grin"],[7.195,"smile"],[7.32,"o"],[7.42,"grin"],[7.585,"smile"],[8.095,"grin"],[8.82,"smile"],[8.92,"o"],[8.995,"grin"],[9.17,"smile"],[9.295,"grin"],[9.555,"smile"],[10.09,"grin"],[10.19,"o"],[10.265,"grin"],[10.415,"smile"],[10.515,"grin"],[10.79,"small"],[10.84,"smile"],[10.915,"grin"],[11.075,"smile"],[11.55,"small"],[11.65,"grin"],[11.875,"small"],[11.95,"smile"],[12.1,"o"],[12.225,"grin"],[12.3,"o"],[12.35,"grin"],[12.475,"open"],[12.575,"small"],[12.675,"o"],[12.725,"grin"],[12.8,"small"],[12.85,"smile"],[13.0,"open"],[13.125,"grin"],[13.245,"smile"],[13.81,"open"],[13.91,"o"],[14.01,"grin"],[14.385,"o"],[14.485,"small"],[14.635,"grin"],[14.735,"o"],[14.975,"smile"],[15.47,"small"],[15.545,"grin"],[15.745,"o"],[15.895,"grin"],[15.97,"o"],[16.02,"grin"],[16.37,"small"],[16.42,"grin"],[16.47,"smile"],[16.57,"grin"],[16.865,"smile"],[17.4,"small"],[17.45,"smile"],[17.55,"open"],[17.65,"grin"],[17.8,"o"],[18.025,"open"],[18.075,"grin"],[18.3,"small"],[18.35,"grin"],[18.525