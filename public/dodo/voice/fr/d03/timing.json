ux et les cacha sous le tapis. Quand grand-mère rentra, elle demanda : « Tout va bien, mon lapinou ? » Pompon répondit : « Oui, oui. » Mais son ventre devint lourd, lourd comme une pierre. Il ne réussit même pas à finir sa soupe de carottes.","words":[0.12,0.595,1.045,1.945,2.17,2.445,3.54,4.115,4.265,4.715,4.815,5.465,5.515,5.665,6.065,6.165,6.315,7.35,7.625,8.125,8.925,9.1,10.26,10.26,10.26,10.545,10.745,11.095,11.245,12.23,12.23,12.23,12.69,13.82,13.82,13.82,14.28,15.21,15.21,15.535,15.785,16.21,16.56,17.235,17.535,17.76,17.96,19.16,19.44,19.615,20.165,20.84,21.14,21.265,21.79,22.015,22.315,22.49],"visemes":[[0.0,"smile"],[0.17,"small"],[0.245,"o"],[0.32,"smile"],[0.395,"small"],[0.495,"o"],[0.62,"grin"],[0.995,"open"],[1.07,"grin"],[1.145,"small"],[1.22,"o"],[1.32,"small"],[1.395,"smile"],[1.495,"grin"],[1.82,"smile"],[1.97,"grin"],[2.295,"o"],[2.37,"grin"],[2.47,"small"],[2.545,"open"],[2.67,"grin"],[2.745,"smile"],[2.82,"open"],[2.895,"smile"],[3.815,"grin"],[4.04,"smile"],[4.14,"grin"],[4.34,"open"],[4.39,"small"],[4.465,"open"],[4.565,"grin"],[4.84,"small"],[4.89,"o"],[4.965,"grin"],[5.165,"smile"],[5.24,"o"],[5.39,"grin"],[5.765,"open"],[5.865,"grin"],[5.99,"open"],[6.09,"grin"],[6.415,"open"],[6.54,"small"],[6.615,"smile"],[6.69,"grin"],[6.835,"smile"],[7.4,"grin"],[7.475,"open"],[7.65,"grin"],[7.8,"open"],[7.9,"small"],[8.0,"grin"],[8.225,"open"],[8.3,"smile"],[8.375,"grin"],[8.525,"smile"],[8.625,"open"],[8.775,"smile"],[8.95,"grin"],[9.25,"small"],[9.325,"open"],[9.4,"smile"],[9.5,"grin"],[9.575,"smile"],[9.675,"open"],[9.865,"smile"],[10.445,"o"],[10.57,"small"],[10.67,"open"],[10.77,"small"],[10.845,"grin"],[11.045,"smile"],[11.12,"o"],[11.32,"open"],[11.42,"small"],[11.52,"grin"],[11.72,"o"],[11.915,"smile"],[12.265,"small"],[12.34,"o"],[12.39,"smile"],[12.49,"small"],[12.59,"o"],[12.715,"grin"],[12.865,"small"],[12.94,"o"],[13.015,"smile"],[13.24,"grin"],[13.425,"smile"],[14.105,"grin"],[14.18,"smile"],[14.305,"o"],[14.355,"smile"],[14.455,"grin"],[