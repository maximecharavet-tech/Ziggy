ile"]]},"s3":{"file":"s3.mp3","dur":24.83,"text":"Pompon resta immobile, le cœur battant. Vite, il ramassa les morceaux et les cacha sous le tapis. Quand grand-mère rentra, elle demanda : « Tout va bien, mon lapinou ? » Pompon répondit : « Oui, oui. » Mais son ventre devint lourd, lourd comme une pierre. Il ne réussit même pas à finir sa soupe de carottes.","words":[0.12,0.645,1.12,2.17,2.395,2.695,3.88,4.505,4.655,5.105,5.205,5.905,5.955,6.105,6.505,6.605,6.755,7.87,8.145,8.645,9.47,9.645,10.83,10.83,10.83,11.165,11.365,11.74,11.89,12.9,12.9,12.9,13.37,14.52,14.52,14.52,15.005,16.03,16.03,16.51,16.76,17.185,17.535,18.26,18.56,18.785,18.985,20.28,20.56,20.735,21.285,21.96,22.26,22.385,22.91,23.135,23.435,23.61],"visemes":[[0.0,"smile"],[0.195,"small"],[0.27,"o"],[0.345,"smile"],[0.42,"small"],[0.545,"o"],[0.67,"grin"],[1.045,"open"],[1.145,"grin"],[1.22,"small"],[1.295,"o"],[1.395,"small"],[1.47,"smile"],[1.595,"grin"],[2.02,"smile"],[2.195,"grin"],[2.47,"smile"],[2.545,"o"],[2.62,"grin"],[2.72,"small"],[2.795,"open"],[2.92,"grin"],[2.995,"smile"],[3.07,"open"],[3.145,"smile"],[4.155,"grin"],[4.43,"smile"],[4.53,"grin"],[4.78,"small"],[4.855,"open"],[4.955,"grin"],[5.28,"o"],[5.355,"grin"],[5.555,"smile"],[5.63,"o"],[5.805,"grin"],[6.205,"open"],[6.305,"grin"],[6.43,"open"],[6.58,"o"],[6.63,"grin"],[6.855,"open"],[6.98,"small"],[7.055,"smile"],[7.13,"grin"],[7.355,"smile"],[7.92,"grin"],[7.995,"open"],[8.17,"grin"],[8.32,"open"],[8.42,"small"],[8.52,"grin"],[8.745,"open"],[8.82,"smile"],[8.895,"grin"],[9.045,"smile"],[9.145,"open"],[9.32,"smile"],[9.495,"grin"],[9.795,"small"],[9.87,"open"],[9.945,"smile"],[10.045,"grin"],[10.12,"smile"],[10.22,"open"],[10.435,"smile"],[10.965,"grin"],[11.04,"o"],[11.19,"small"],[11.29,"open"],[11.39,"small"],[11.465,"grin"],[11.69,"smile"],[11.765,"small"],[11.815,"o"],[11.915,"grin"],[11.965,"open"],[12.065,"small"],[12.165,"grin"],[12.365,"o"],[12.585,"smile"],[12.945,"small"],[13.02,"o"],[13.07,"smile"],[13.17,"small"],[13.27,"o