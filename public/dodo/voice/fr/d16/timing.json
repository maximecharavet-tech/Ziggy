{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d16","segments":{"title":{"file":"title.mp3","dur":2.93,"text":"La petite gardienne du phare","words":[0.12,0.495,1.02,1.595,1.845],"visemes":[[0.0,"smile"],[0.295,"grin"],[0.37,"open"],[0.52,"small"],[0.595,"grin"],[1.12,"open"],[1.195,"grin"],[1.67,"o"],[1.745,"smile"],[1.87,"small"],[1.945,"smile"],[2.12,"open"],[2.27,"grin"],[2.455,"smile"]]},"s1":{"file":"s1.mp3","dur":26.05,"text":"Sur une petite île, au bord de la mer, se dressait un phare blanc et rouge. Chaque nuit, sa lumière tournait, tournait, pour guider les bateaux jusqu’au port. Dans la maison du phare vivaient Inès et sa grand-mère, Mamie Lou. Inès avait deux tresses brunes, un ciré rouge et des bottes jaunes. Elle adorait regarder la lumière balayer les vagues.","words":[0.12,0.45,0.65,1.2,1.775,1.925,2.225,2.3,2.525,3.4,3.6,4.175,4.35,4.7,5.075,5.225,6.41,6.89,7.39,7.565,8.09,8.765,9.54,9.79,10.14,10.29,10.69,11.14,12.23,12.485,12.635,13.01,13.235,13.835,14.21,14.835,14.985,15.16,15.935,16.335,17.08,17.595,17.795,17.97,18.37,19.295,19.52,19.895,20.22,20.32,20.47,20.795,22.06,22.39,22.94,23.59,23.765,24.315,24.79,25.015],"visemes":[[0.0,"smile"],[0.225,"grin"],[0.3,"o"],[0.375,"grin"],[0.475,"o"],[0.55,"grin"],[0.675,"small"],[0.75,"grin"],[1.225,"smile"],[1.325,"grin"],[1.65,"smile"],[1.8,"o"],[1.95,"small"],[2.0,"smile"],[2.075,"o"],[2.15,"grin"],[2.4,"open"],[2.55,"small"],[2.625,"smile"],[2.775,"grin"],[3.25,"smile"],[3.425,"grin"],[4.2,"o"],[4.375,"small"],[4.425,"smile"],[4.5,"open"],[4.575,"grin"],[4.725,"small"],[4.85,"smile"],[4.925,"open"],[5.1,"grin"],[5.325,"smile"],[5.45,"o"],[5.65,"grin"],[5.895,"smile"],[6.565,"grin"],[6.665,"open"],[6.765,"grin"],[6.99,"o"],[7.065,"smile"],[7.14,"grin"],[7.29,"smile"],[7.415,"grin"],[7.49,"open"],[7.59,"grin"],[7.64,"o"],[7.715,"small"],[7.79,"grin"],[8.19,"o"],[8.29,"grin"],[8.465,"smile"],[8.54,"grin"],[8.64,"smile"],[8.79,"grin"],[8.865,"o"],[8.965,"grin"],[9.14,"smile"],[9.215,"grin"],[9.415,"smile