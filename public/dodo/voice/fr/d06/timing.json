che tout doucement, sur la pointe des pattes. Il prend le nid dans sa grosse patte, avec beaucoup de délicatesse. Puis il se met debout, se fait très, très grand, et repose le nid sur la plus haute branche. Pépite vole jusqu’à lui. « Merci, Bruno ! Tu es grand, et tu es gentil ! »","words":[0.12,0.77,1.47,1.67,2.52,2.72,2.945,3.22,3.445,4.59,4.94,5.215,5.365,5.565,5.74,5.915,6.265,7.115,7.44,7.79,7.94,9.76,10.16,10.335,10.51,10.71,11.535,11.735,11.96,12.335,12.635,13.36,13.46,13.935,14.085,14.285,14.435,14.61,14.81,15.06,16.47,16.97,17.27,17.77,18.75,18.75,19.425,20.83,20.83,21.105,21.255,21.705,21.855,22.03,22.155,22.155,22.155],"visemes":[[0.0,"smile"],[0.295,"small"],[0.37,"grin"],[0.445,"o"],[0.545,"grin"],[0.67,"o"],[0.795,"grin"],[0.895,"open"],[0.995,"small"],[1.07,"grin"],[1.12,"smile"],[1.195,"o"],[1.295,"grin"],[1.57,"o"],[1.695,"grin"],[1.77,"o"],[1.895,"grin"],[1.995,"small"],[2.07,"smile"],[2.145,"open"],[2.22,"smile"],[2.545,"grin"],[2.62,"o"],[2.695,"grin"],[2.82,"open"],[2.97,"small"],[3.02,"grin"],[3.47,"small"],[3.545,"smile"],[3.645,"open"],[3.82,"grin"],[4.075,"smile"],[4.715,"grin"],[4.965,"small"],[5.04,"grin"],[5.115,"open"],[5.24,"grin"],[5.64,"open"],[5.765,"grin"],[5.84,"open"],[5.94,"grin"],[6.065,"o"],[6.14,"grin"],[6.29,"small"],[6.365,"smile"],[6.49,"open"],[6.665,"grin"],[6.965,"smile"],[7.14,"open"],[7.215,"small"],[7.29,"grin"],[7.465,"small"],[7.54,"o"],[7.64,"grin"],[7.74,"o"],[7.815,"grin"],[8.365,"open"],[8.49,"grin"],[8.565,"smile"],[8.69,"grin"],[9.125,"smile"],[9.81,"small"],[9.935,"smile"],[10.01,"grin"],[10.535,"small"],[10.635,"grin"],[10.935,"small"],[11.01,"smile"],[11.085,"o"],[11.36,"smile"],[11.56,"grin"],[11.76,"small"],[11.86,"grin"],[12.11,"smile"],[12.185,"grin"],[12.26,"smile"],[12.36,"grin"],[12.785,"smile"],[12.86,"open"],[12.935,"smile"],[13.385,"grin"],[13.71,"smile"],[13.785,"o"],[13.86,"grin"],[14.36,"o"],[14.41,"grin"],[14.51,"open"],[14.635,"small"],[14.685,"grin"],[14.735,"o"],[14.96,"grin"],[15.085,"smal