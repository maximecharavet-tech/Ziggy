l"],[24.385,"open"],[24.46,"grin"],[24.685,"smile"],[24.86,"grin"],[25.145,"smile"],[25.985,"grin"],[26.21,"small"],[26.285,"o"],[26.385,"grin"],[26.91,"o"],[27.035,"grin"],[27.16,"o"],[27.26,"grin"],[27.485,"smile"],[27.585,"open"],[27.855,"smile"]]},"s3":{"file":"s3.mp3","dur":30.42,"text":"Zita alla s’asseoir sous un acacia. La vieille girafe Nala pencha son long cou vers elle. « Pourquoi fais-tu cette tête, petite ? » Zita lui expliqua tout. La girafe sourit. « Tu veux connaître un secret ? Aucun zèbre n’a les mêmes rayures qu’un autre. Pas un seul ! Chaque zèbre est unique. Toi, tu es simplement unique d’une façon un peu plus visible. »","words":[0.12,0.72,1.02,1.57,1.795,1.895,3.21,3.515,3.865,4.69,5.04,5.49,5.64,5.815,5.965,6.29,7.35,7.35,8.0,8.4,8.7,9.05,10.57,10.57,10.57,11.12,11.27,12.07,13.0,13.275,13.7,14.81,14.81,15.21,15.485,16.01,16.185,17.55,17.55,18.055,18.555,18.705,18.905,19.23,19.73,20.055,21.24,21.625,21.9,23.1,23.1,23.59,23.965,24.165,25.6,26.165,26.365,26.54,27.29,27.79,28.09,28.565,28.69,28.915,29.14,29.14],"visemes":[[0.0,"smile"],[0.27,"grin"],[0.545,"smile"],[0.62,"open"],[0.82,"grin"],[0.92,"open"],[1.045,"grin"],[1.145,"open"],[1.245,"grin"],[1.345,"o"],[1.445,"open"],[1.495,"grin"],[1.67,"o"],[1.745,"grin"],[1.82,"o"],[1.87,"grin"],[1.92,"open"],[1.995,"grin"],[2.095,"open"],[2.22,"grin"],[2.395,"smile"],[2.47,"open"],[2.695,"smile"],[3.315,"grin"],[3.39,"open"],[3.54,"small"],[3.615,"grin"],[4.14,"smile"],[4.24,"open"],[4.365,"small"],[4.715,"grin"],[4.79,"open"],[4.865,"grin"],[4.965,"open"],[5.19,"smile"],[5.29,"grin"],[5.415,"open"],[5.565,"o"],[5.84,"grin"],[5.915,"o"],[5.99,"small"],[6.065,"grin"],[6.315,"smile"],[6.44,"grin"],[6.835,"smile"],[7.5,"small"],[7.575,"o"],[7.675,"grin"],[7.825,"o"],[7.9,"open"],[8.025,"small"],[8.125,"grin"],[8.275,"o"],[8.425,"grin"],[8.8,"smile"],[8.875,"grin"],[9.0,"smile"],[9.075,"small"],[9.15,"grin"],[9.375,"smile"],[9.475,"grin"],[9.925,"smile"],[10.72,"grin"],[10.995,"smile"],[11.07,"open"],[1