:{"file":"s5.mp3","dur":27.4,"text":"Puis vint la chanson d’hiver. Mamie la chantait déjà quand elle était petite. « Dors, dors, sous la neige, la famille te protège… » Papa tapait doucement le rythme. Maman fredonnait. Tilou bâillait déjà. Nina chantait les mots qu’elle connaissait, et inventait les autres. Tout le monde riait tout bas. Dehors, les premiers flocons tombaient sur la montagne.","words":[0.12,0.445,0.595,0.77,1.245,2.43,2.905,3.105,3.63,4.13,4.405,4.505,4.705,5.93,5.93,6.48,6.83,7.005,7.205,7.955,8.18,8.63,8.805,10.56,10.56,11.035,11.385,11.81,11.985,13.12,13.645,14.86,15.285,15.61,16.66,17.175,17.6,17.75,17.95,18.2,19.15,19.275,19.775,20.075,21.15,21.35,21.475,21.75,22.075,22.3,23.29,24.145,24.37,24.845,25.42,25.895,26.095,26.22],"visemes":[[0.0,"smile"],[0.17,"small"],[0.245,"o"],[0.345,"grin"],[0.47,"small"],[0.545,"grin"],[0.67,"open"],[0.795,"grin"],[0.87,"open"],[0.945,"smile"],[1.02,"grin"],[1.145,"o"],[1.27,"grin"],[1.445,"small"],[1.545,"smile"],[1.72,"grin"],[1.915,"smile"],[2.555,"small"],[2.63,"open"],[2.73,"small"],[2.83,"grin"],[2.98,"open"],[3.13,"grin"],[3.205,"open"],[3.28,"smile"],[3.38,"grin"],[3.93,"smile"],[4.005,"open"],[4.155,"grin"],[4.23,"open"],[4.355,"grin"],[4.73,"small"],[4.805,"grin"],[5.03,"smile"],[5.105,"grin"],[5.415,"smile"],[6.305,"o"],[6.43,"smile"],[6.655,"o"],[6.78,"smile"],[6.855,"grin"],[6.93,"o"],[7.03,"grin"],[7.105,"open"],[7.23,"grin"],[7.305,"smile"],[7.43,"grin"],[7.805,"smile"],[7.98,"grin"],[8.055,"open"],[8.205,"small"],[8.28,"open"],[8.38,"small"],[8.505,"grin"],[8.83,"small"],[8.905,"grin"],[8.98,"o"],[9.105,"grin"],[9.205,"smile"],[9.33,"grin"],[9.58,"smile"],[10.61,"small"],[10.685,"open"],[10.785,"small"],[10.86,"smile"],[10.935,"open"],[11.06,"grin"],[11.135,"open"],[11.235,"small"],[11.335,"grin"],[11.46,"o"],[11.56,"grin"],[11.66,"small"],[11.76,"open"],[11.835,"grin"],[12.06,"smile"],[12.135,"grin"],[12.385,"small"],[12.605,"smile"],[13.245,"small"],[13.32,"open"],[13.395,"small"],[13.495,"ope