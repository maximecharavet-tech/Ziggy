{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d10","segments":{"title":{"file":"title.mp3","dur":2.47,"text":"Les deux pingouins fâchés","words":[0.12,0.495,0.77,1.245],"visemes":[[0.0,"smile"],[0.295,"grin"],[0.57,"smile"],[0.645,"o"],[0.795,"small"],[0.87,"grin"],[0.945,"smile"],[1.02,"grin"],[1.095,"o"],[1.145,"grin"],[1.27,"small"],[1.37,"open"],[1.52,"grin"],[1.62,"smile"],[1.72,"grin"],[1.995,"smile"]]},"s1":{"file":"s1.mp3","dur":25.17,"text":"Sur la banquise toute blanche, là où la neige brille comme du sucre, vivent deux pingouins. Kiko porte une écharpe rouge. Nuna porte un bonnet bleu avec un pompon. Ce sont les meilleurs amis du monde. Ensemble, ils glissent sur le ventre, attrapent des flocons et regardent les lumières du ciel danser la nuit.","words":[0.12,0.47,0.645,1.27,1.62,2.82,3.045,3.145,3.32,3.695,4.12,4.37,4.595,5.495,5.82,6.045,7.35,7.8,8.15,8.275,8.825,10.1,10.625,11.025,11.15,11.5,11.8,12.1,12.225,13.45,13.79,13.94,14.115,14.69,14.965,15.19,16.6,17.78,17.98,18.38,18.63,18.855,20.03,20.555,20.755,21.455,21.58,22.28,22.455,23.005,23.23,23.58,24.005,24.23],"visemes":[[0.0,"smile"],[0.27,"grin"],[0.345,"o"],[0.42,"grin"],[0.57,"open"],[0.67,"small"],[0.745,"open"],[0.82,"smile"],[0.92,"grin"],[0.995,"smile"],[1.07,"grin"],[1.37,"o"],[1.495,"grin"],[1.645,"small"],[1.72,"grin"],[1.77,"smile"],[1.87,"open"],[1.995,"smile"],[2.17,"grin"],[2.62,"smile"],[2.845,"grin"],[2.895,"smile"],[2.97,"open"],[3.07,"o"],[3.17,"grin"],[3.245,"open"],[3.345,"grin"],[3.395,"smile"],[3.47,"grin"],[3.72,"small"],[3.845,"smile"],[3.92,"grin"],[4.22,"o"],[4.295,"small"],[4.395,"o"],[4.62,"grin"],[4.695,"smile"],[4.77,"o"],[4.92,"grin"],[5.32,"smile"],[5.52,"small"],[5.62,"grin"],[5.695,"small"],[5.845,"grin"],[5.945,"o"],[6.07,"small"],[6.145,"grin"],[6.22,"smile"],[6.32,"grin"],[6.395,"o"],[6.47,"smile"],[6.545,"grin"],[6.62,"smile"],[7.4,"grin"],[7.7,"o"],[7.825,"small"],[7.925,"o"],[8.0,"grin"],[8.525,"open"],[8.6,"grin"],[8.675,"small"],[8.85,"grin"],[8.925,"sm