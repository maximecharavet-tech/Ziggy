{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d07","segments":{"title":{"file":"title.mp3","dur":2.74,"text":"Le vieux chêne qui chuchotait","words":[0.12,0.485,0.81,1.135,1.36],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.51,"small"],[0.585,"grin"],[0.685,"o"],[0.835,"grin"],[1.46,"o"],[1.56,"grin"],[1.66,"o"],[1.81,"grin"],[1.91,"smile"],[2.01,"grin"],[2.265,"smile"]]},"s1":{"file":"s1.mp3","dur":23.35,"text":"Au milieu d’une prairie se dressait un chêne très, très vieux. Ses branches étaient longues comme des bras ouverts, et ses racines plongeaient profond dans la terre. Les gens du village l’appelaient Grand-Père Chêne. On disait que, les soirs calmes, il chuchotait. Mais pour l’entendre, il fallait savoir écouter.","words":[0.12,0.35,0.8,1.05,1.775,1.95,2.475,2.65,3.025,3.425,3.775,4.77,5.12,5.695,6.045,6.545,6.795,6.945,7.32,8.345,8.495,8.67,9.245,9.695,10.12,10.245,10.445,11.49,11.795,12.02,12.195,13.12,13.495,14.145,15.25,15.475,15.875,16.05,16.2,16.475,17.125,17.325,18.86,19.4,19.625,20.9,21.125,21.5,22.025],"visemes":[[0.0,"smile"],[0.225,"o"],[0.375,"small"],[0.45,"grin"],[0.725,"o"],[0.95,"grin"],[1.075,"small"],[1.15,"grin"],[1.4,"smile"],[1.475,"grin"],[1.675,"smile"],[1.8,"grin"],[2.5,"o"],[2.675,"grin"],[2.75,"smile"],[2.825,"grin"],[3.175,"smile"],[3.25,"grin"],[3.35,"smile"],[3.45,"grin"],[3.8,"small"],[3.875,"grin"],[3.95,"smile"],[4.025,"o"],[4.255,"smile"],[4.895,"grin"],[5.145,"small"],[5.27,"smile"],[5.345,"open"],[5.42,"smile"],[5.52,"grin"],[6.12,"smile"],[6.195,"o"],[6.27,"smile"],[6.37,"grin"],[6.645,"o"],[6.72,"small"],[6.82,"grin"],[6.97,"small"],[7.095,"smile"],[7.17,"open"],[7.245,"grin"],[7.345,"o"],[7.445,"small"],[7.52,"smile"],[7.67,"grin"],[8.17,"smile"],[8.37,"grin"],[8.795,"open"],[8.895,"grin"],[8.995,"smile"],[9.07,"grin"],[9.37,"o"],[9.445,"smile"],[9.52,"grin"],[9.72,"small"],[9.795,"grin"],[9.87,"o"],[9.97,"small"],[10.07,"o"],[10.145,"open"],[10.47,"grin"],[10.545,"smile"],[10.72,"grin"],[10.975,"smile"],[11.595,"grin"],