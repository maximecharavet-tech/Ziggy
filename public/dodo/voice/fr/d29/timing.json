lie s’assit sur un champignon et soupira très fort. Madame Escargot passait par là, lentement, tout lentement. « Pourquoi es-tu si pressée, petite chenille ? » « Parce que je veux être un papillon maintenant ! » dit Zélie.","words":[0.12,0.46,0.86,1.06,1.56,1.71,2.235,2.51,2.785,3.59,3.855,4.33,4.755,4.855,5.005,5.405,5.905,6.18,7.07,7.575,8.075,8.275,8.45,9.3,9.45,9.975,10.3,11.24,11.77,12.395,12.77,13.02,13.37,13.97,14.12,15.26,15.26,15.71,15.985,16.16,16.76,17.185,18.7,18.7,18.7,18.7,19.175,19.325,19.55,19.925,20.275,20.4,20.875,21.97,21.97,21.97,22.37],"visemes":[[0.0,"smile"],[0.235,"grin"],[0.56,"o"],[0.635,"grin"],[0.685,"smile"],[0.76,"open"],[0.885,"grin"],[0.96,"o"],[1.085,"small"],[1.16,"grin"],[1.335,"smile"],[1.41,"open"],[1.485,"grin"],[1.735,"small"],[1.81,"open"],[1.91,"grin"],[2.335,"o"],[2.41,"grin"],[2.635,"o"],[2.86,"smile"],[2.935,"o"],[3.075,"smile"],[3.68,"grin"],[3.93,"o"],[4.03,"grin"],[4.13,"o"],[4.23,"smile"],[4.405,"o"],[4.505,"grin"],[4.605,"smile"],[4.78,"grin"],[5.48,"open"],[5.63,"grin"],[5.98,"open"],[6.105,"grin"],[6.205,"smile"],[6.305,"grin"],[6.555,"smile"],[7.225,"grin"],[7.7,"open"],[7.8,"grin"],[8.3,"o"],[8.475,"grin"],[8.55,"open"],[8.625,"smile"],[8.7,"small"],[8.775,"grin"],[9.05,"o"],[9.325,"grin"],[9.55,"o"],[9.65,"small"],[9.725,"grin"],[9.9,"open"],[10.0,"grin"],[10.325,"small"],[10.4,"smile"],[10.55,"o"],[10.675,"smile"],[11.345,"small"],[11.42,"open"],[11.495,"grin"],[11.545,"smile"],[11.62,"open"],[11.695,"small"],[11.795,"grin"],[12.02,"open"],[12.12,"grin"],[12.295,"o"],[12.42,"small"],[12.495,"open"],[12.595,"grin"],[12.795,"small"],[12.87,"open"],[12.945,"grin"],[13.095,"smile"],[13.17,"open"],[13.295,"smile"],[13.445,"open"],[13.52,"smile"],[13.595,"grin"],[13.695,"small"],[13.795,"open"],[13.895,"smile"],[13.995,"grin"],[14.07,"o"],[14.195,"open"],[14.27,"smile"],[14.37,"grin"],[14.47,"small"],[14.545,"smile"],[14.62,"open"],[14.67,"smile"],[15.41,"o"],[15.485,"grin"],[15.66,"open"],[15.735,"grin"],[15.885,"o"]