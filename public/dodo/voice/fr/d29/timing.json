{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d29","segments":{"title":{"file":"title.mp3","dur":2.32,"text":"La chenille pressée","words":[0.12,0.52,0.995],"visemes":[[0.0,"smile"],[0.295,"grin"],[0.37,"open"],[0.545,"grin"],[1.02,"small"],[1.095,"grin"],[1.47,"smile"],[1.57,"grin"],[1.845,"smile"]]},"s1":{"file":"s1.mp3","dur":26.88,"text":"Dans un jardin plein de trèfles et de pâquerettes vivait une petite chenille verte nommée Zélie. Elle avait de petites pattes rapides et de grands yeux curieux. Chaque matin, elle regardait les papillons danser au-dessus des fleurs. Bleus, jaunes, orange… « Un jour, je serai comme eux », disait-elle. « Mais je voudrais que ce soit aujourd’hui ! »","words":[0.12,0.57,0.77,1.37,1.62,1.82,2.995,3.095,3.32,3.92,4.42,4.62,5.145,5.72,6.17,6.545,7.7,7.975,8.175,8.35,8.85,9.15,10.25,10.35,10.525,10.875,11.05,12.24,12.655,13.405,13.58,14.13,14.28,14.73,15.33,15.755,15.98,17.22,17.62,17.97,19.87,19.87,20.195,20.57,20.745,21.07,21.345,21.82,21.82,23.51,23.51,24.075,24.3,24.75,24.925,25.15,25.525,25.525,25.525],"visemes":[[0.0,"smile"],[0.27,"grin"],[0.345,"open"],[0.47,"grin"],[0.595,"o"],[0.795,"grin"],[0.895,"open"],[0.995,"grin"],[1.145,"smile"],[1.22,"grin"],[1.995,"smile"],[2.095,"grin"],[2.245,"small"],[2.395,"grin"],[3.345,"small"],[3.42,"open"],[3.52,"grin"],[3.945,"small"],[4.02,"grin"],[4.12,"small"],[4.195,"smile"],[4.27,"grin"],[4.445,"o"],[4.52,"grin"],[4.645,"small"],[4.72,"grin"],[5.42,"smile"],[5.495,"grin"],[5.745,"small"],[5.82,"smile"],[5.895,"grin"],[6.27,"o"],[6.345,"small"],[6.445,"grin"],[6.87,"smile"],[6.945,"grin"],[7.185,"smile"],[7.825,"grin"],[8.0,"open"],[8.05,"small"],[8.125,"grin"],[8.375,"small"],[8.45,"grin"],[8.875,"small"],[8.975,"open"],[9.05,"grin"],[9.275,"open"],[9.4,"small"],[9.5,"smile"],[9.625,"grin"],[10.725,"open"],[10.825,"grin"],[10.95,"o"],[11.075,"grin"],[11.15,"o"],[11.25,"grin"],[11.425,"smile"],[11.5,"o"],[11.725,"smile"],[12.38,"grin"],[12.48,"open"],[12.58,"grin"],[12.68,"small"],[12