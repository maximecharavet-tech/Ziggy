{"v":2,"voice":"ziggy-v2","locale":"fr","story":"d08","segments":{"title":{"file":"title.mp3","dur":2.36,"text":"Le merci du hérisson","words":[0.12,0.435,0.935,1.135],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.46,"small"],[0.535,"grin"],[1.035,"o"],[1.16,"grin"],[1.61,"smile"],[1.685,"o"],[1.76,"smile"]]},"s1":{"file":"s1.mp3","dur":24.89,"text":"À l’orée d’un bois, sous un tas de feuilles dorées, vit Gaspard, un petit hérisson. Il porte un bonnet bleu tricoté, tout petit, posé entre ses piquants. Ce matin, Gaspard se réveille de mauvaise humeur. « Il ne m’arrive jamais rien de bien », grogne-t-il. Sa maman lui sourit : « Ouvre bien les yeux aujourd’hui. Tu verras. »","words":[0.12,0.35,0.75,1.0,1.45,1.725,1.85,2.025,2.25,2.55,3.3,3.475,4.325,4.45,4.85,6.12,6.445,6.82,6.945,7.22,7.445,8.445,8.645,9.22,9.62,9.895,10.07,11.2,11.475,12.075,12.675,12.825,13.2,13.325,13.725,14.79,14.79,15.065,15.215,15.89,16.29,16.49,16.64,17.3,17.3,18.88,19.155,19.455,19.705,20.61,20.61,20.61,21.15,21.425,21.725,22.025,23.43,23.755,23.755],"visemes":[[0.0,"smile"],[0.25,"open"],[0.375,"grin"],[0.45,"o"],[0.55,"grin"],[0.85,"o"],[1.025,"small"],[1.075,"o"],[1.125,"smile"],[1.2,"open"],[1.325,"smile"],[1.475,"grin"],[1.55,"o"],[1.625,"grin"],[1.75,"o"],[1.875,"grin"],[1.95,"open"],[2.05,"grin"],[2.325,"smile"],[2.4,"o"],[2.475,"grin"],[2.65,"o"],[2.75,"grin"],[2.825,"smile"],[2.925,"grin"],[3.15,"smile"],[3.325,"small"],[3.4,"grin"],[3.6,"open"],[3.7,"grin"],[3.8,"small"],[3.9,"smile"],[4.05,"open"],[4.175,"grin"],[4.25,"smile"],[4.35,"o"],[4.475,"small"],[4.55,"grin"],[5.3,"smile"],[5.375,"o"],[5.45,"smile"],[6.22,"grin"],[6.52,"smile"],[6.595,"o"],[6.67,"grin"],[6.845,"o"],[7.095,"grin"],[7.37,"o"],[7.47,"grin"],[7.795,"o"],[7.92,"grin"],[7.995,"smile"],[8.095,"grin"],[8.295,"smile"],[8.47,"grin"],[8.52,"o"],[8.67,"small"],[8.745,"grin"],[8.97,"smile"],[9.045,"grin"],[9.145,"smile"],[9.245,"small"],[9.32,"o"],[9.42,"grin"],[9.645,"open"],[9.745,"grin"],[10.095,"small"],[10.17,"grin"],[