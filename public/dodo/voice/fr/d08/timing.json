{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d08","segments":{"title":{"file":"title.mp3","dur":2.53,"text":"Le merci du hérisson","words":[0.12,0.435,0.96,1.16],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.46,"small"],[0.535,"grin"],[1.06,"o"],[1.185,"grin"],[1.635,"smile"],[1.71,"o"],[1.81,"smile"]]},"s1":{"file":"s1.mp3","dur":25.65,"text":"À l’orée d’un bois, sous un tas de feuilles dorées, vit Gaspard, un petit hérisson. Il porte un bonnet bleu tricoté, tout petit, posé entre ses piquants. Ce matin, Gaspard se réveille de mauvaise humeur. « Il ne m’arrive jamais rien de bien », grogne-t-il. Sa maman lui sourit : « Ouvre bien les yeux aujourd’hui. Tu verras. »","words":[0.12,0.35,0.75,1.0,1.475,1.75,1.875,2.05,2.275,2.575,3.375,3.55,4.45,4.575,4.975,6.29,6.615,6.99,7.115,7.39,7.615,8.665,8.89,9.465,9.865,10.14,10.315,11.49,11.765,12.39,12.99,13.14,13.515,13.64,14.04,15.22,15.22,15.495,15.645,16.32,16.72,16.92,17.07,17.78,17.78,19.49,19.765,20.065,20.315,21.19,21.19,21.19,21.705,21.955,22.255,22.53,24.03,24.355,24.355],"visemes":[[0.0,"smile"],[0.25,"open"],[0.375,"grin"],[0.45,"o"],[0.55,"grin"],[0.85,"o"],[1.025,"small"],[1.075,"o"],[1.125,"smile"],[1.2,"open"],[1.35,"smile"],[1.5,"grin"],[1.575,"o"],[1.65,"grin"],[1.775,"o"],[1.9,"grin"],[1.975,"open"],[2.075,"grin"],[2.3,"small"],[2.35,"smile"],[2.425,"o"],[2.5,"grin"],[2.675,"o"],[2.775,"grin"],[2.85,"smile"],[2.95,"grin"],[3.225,"smile"],[3.4,"small"],[3.475,"grin"],[3.675,"open"],[3.8,"grin"],[3.9,"small"],[4.0,"smile"],[4.15,"open"],[4.3,"grin"],[4.375,"smile"],[4.475,"o"],[4.6,"small"],[4.675,"grin"],[5.425,"smile"],[5.5,"o"],[5.575,"smile"],[6.39,"grin"],[6.69,"smile"],[6.765,"o"],[6.84,"grin"],[7.015,"o"],[7.265,"grin"],[7.54,"o"],[7.64,"grin"],[7.965,"o"],[8.09,"grin"],[8.165,"smile"],[8.265,"grin"],[8.515,"smile"],[8.69,"grin"],[8.765,"o"],[8.915,"small"],[8.99,"grin"],[9.215,"smile"],[9.29,"grin"],[9.39,"smile"],[9.49,"small"],[9.565,"o"],[9.665,"grin"],[9.89,"open"],[9.99,"grin"],[10.34,"small"],