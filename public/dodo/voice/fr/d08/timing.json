u plein de cadeaux ! » Il compte sur ses petites pattes : le soleil, la rosée, la fraise, la chanson, la feuille, la grenouille, l’arc-en-ciel… « Et toi, maman. Merci. »","words":[0.12,0.47,0.97,1.495,1.92,2.095,2.96,3.26,3.585,4.285,4.56,4.685,4.935,5.11,5.41,5.935,6.035,6.16,6.56,6.81,7.77,8.395,8.595,8.97,9.94,9.94,10.515,11.39,11.54,11.965,12.14,12.265,13.33,13.33,13.33,13.61,13.96,14.185,14.335,14.76,15.41,15.41,15.585,16.41,16.56,17.01,17.21,17.76,17.96,18.685,18.935,19.435,19.585,20.21,22.15,22.15,22.4,22.675,23.9,23.9],"visemes":[[0.0,"smile"],[0.245,"grin"],[0.57,"o"],[0.645,"smile"],[0.77,"open"],[0.87,"grin"],[0.92,"smile"],[0.995,"grin"],[1.07,"open"],[1.17,"grin"],[1.27,"small"],[1.37,"open"],[1.42,"grin"],[1.595,"open"],[1.695,"grin"],[2.195,"o"],[2.27,"smile"],[2.345,"grin"],[2.445,"smile"],[3.085,"grin"],[3.185,"open"],[3.285,"small"],[3.36,"open"],[3.435,"small"],[3.535,"open"],[3.61,"grin"],[3.685,"open"],[3.81,"grin"],[3.885,"smile"],[3.96,"open"],[4.385,"small"],[4.435,"grin"],[4.585,"o"],[4.71,"small"],[4.81,"grin"],[5.21,"o"],[5.285,"small"],[5.435,"grin"],[5.56,"smile"],[5.635,"grin"],[6.06,"o"],[6.185,"grin"],[6.26,"open"],[6.335,"grin"],[6.66,"o"],[6.885,"smile"],[6.96,"o"],[7.135,"smile"],[7.895,"grin"],[7.995,"open"],[8.095,"grin"],[8.195,"small"],[8.295,"open"],[8.345,"grin"],[8.47,"open"],[8.62,"grin"],[8.87,"smile"],[8.995,"small"],[9.07,"smile"],[9.22,"o"],[9.345,"grin"],[9.425,"smile"],[10.115,"small"],[10.19,"open"],[10.29,"small"],[10.39,"open"],[10.465,"smile"],[10.54,"o"],[10.64,"grin"],[10.715,"o"],[10.815,"grin"],[10.99,"smile"],[11.065,"grin"],[11.24,"smile"],[11.415,"grin"],[11.865,"o"],[11.99,"small"],[12.04,"grin"],[12.39,"open"],[12.49,"grin"],[12.54,"smile"],[12.615,"o"],[12.785,"smile"],[13.41,"grin"],[13.735,"o"],[13.81,"smile"],[13.885,"grin"],[14.035,"o"],[14.11,"grin"],[14.36,"small"],[14.41,"grin"],[14.835,"smile"],[14.96,"open"],[15.085,"grin"],[15.36,"smile"],[15.435,"grin"],[15.71,"o"],[15.81,"grin"],[15.885,"smil