ux de bois. Il dormait, bien au frais, en rêvant du printemps. L’hiver prochain, ses amis viendront le voir. Chut… toi aussi, rêve aux fleurs.","words":[0.12,0.77,1.145,1.37,2.07,2.295,2.695,2.895,3.445,4.67,5.245,5.47,5.795,6.17,6.32,7.27,7.7,8.2,8.65,8.875,9.525,9.775,10.0,10.325,10.45,11.78,12.48,13.18,13.405,13.83,13.905,14.13,15.155,15.555,15.805,16.28,16.58,16.73,16.955,17.9,18.29,18.84,19.165,19.34,20.065,20.265,20.615,20.79,22.19,22.845,23.795,24.095,24.42,24.895,25.12,26.49,26.92,27.12,27.595,27.92,28.095],"visemes":[[0.0,"smile"],[0.245,"small"],[0.32,"grin"],[0.395,"o"],[0.495,"grin"],[0.62,"o"],[0.795,"small"],[0.87,"o"],[0.97,"grin"],[1.095,"open"],[1.17,"grin"],[1.245,"open"],[1.395,"grin"],[1.47,"smile"],[1.57,"open"],[1.67,"grin"],[1.945,"smile"],[2.095,"grin"],[2.17,"o"],[2.32,"grin"],[2.37,"o"],[2.445,"smile"],[2.52,"grin"],[2.795,"o"],[2.87,"grin"],[3.145,"open"],[3.22,"grin"],[3.295,"small"],[3.47,"grin"],[3.545,"smile"],[3.67,"o"],[3.87,"grin"],[4.155,"smile"],[4.87,"grin"],[4.945,"smile"],[5.02,"open"],[5.12,"smile"],[5.27,"grin"],[5.82,"small"],[5.895,"grin"],[5.97,"smile"],[6.045,"grin"],[6.42,"smile"],[6.495,"o"],[6.755,"smile"],[7.425,"grin"],[7.95,"smile"],[8.025,"open"],[8.1,"grin"],[8.225,"small"],[8.3,"grin"],[8.75,"o"],[8.9,"small"],[9.0,"grin"],[9.075,"smile"],[9.175,"grin"],[9.375,"smile"],[9.55,"grin"],[9.625,"o"],[9.7,"small"],[9.8,"grin"],[10.025,"small"],[10.1,"grin"],[10.2,"o"],[10.275,"grin"],[10.55,"o"],[10.65,"small"],[10.75,"grin"],[10.825,"smile"],[10.975,"grin"],[11.265,"smile"],[11.905,"small"],[11.98,"grin"],[12.055,"o"],[12.18,"grin"],[12.255,"smile"],[12.33,"o"],[12.505,"grin"],[12.755,"open"],[12.855,"grin"],[13.03,"smile"],[13.105,"open"],[13.205,"grin"],[13.505,"o"],[13.58,"grin"],[13.755,"small"],[13.855,"grin"],[14.005,"open"],[14.155,"grin"],[14.23,"smile"],[14.355,"open"],[14.48,"grin"],[14.955,"smile"],[15.18,"small"],[15.255,"o"],[15.33,"smile"],[15.405,"grin"],[15.83,"small"],[15.905,"grin"],[16.08,"small"],[