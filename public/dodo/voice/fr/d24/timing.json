{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d24","segments":{"title":{"file":"title.mp3","dur":2.89,"text":"Le chaton et le pont de lianes","words":[0.12,0.51,1.01,1.11,1.31,1.535,1.685],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.635,"open"],[0.76,"grin"],[0.885,"o"],[1.035,"grin"],[1.335,"small"],[1.435,"o"],[1.56,"grin"],[1.86,"smile"],[1.985,"open"],[2.135,"grin"],[2.415,"smile"]]},"s1":{"file":"s1.mp3","dur":26.7,"text":"Dans une forêt chaude et verte, entre deux grands arbres, il y avait un pont de lianes. Il se balançait doucement au-dessus d’un ruisseau qui chantait. D’un côté vivait Pilou, un petit chaton tigré. De l’autre côté vivait son ami Bako, un petit singe aux grandes oreilles. Chaque jour, Bako traversait le pont en sautillant pour venir jouer.","words":[0.12,0.52,0.77,1.295,1.82,1.97,2.745,3.12,3.32,3.72,4.745,4.92,5.02,5.345,5.495,5.695,5.845,7.09,7.345,7.495,8.195,8.745,9.195,9.37,9.82,9.995,11.05,11.4,11.8,12.125,12.875,13.05,13.45,13.85,15.04,15.355,15.755,16.255,16.68,16.905,17.13,18.105,18.305,18.78,19.205,19.355,19.83,21.23,21.735,22.535,22.935,23.685,23.91,24.235,24.41,24.985,25.21,25.735],"visemes":[[0.0,"smile"],[0.245,"grin"],[0.32,"open"],[0.445,"grin"],[0.545,"o"],[0.62,"grin"],[0.795,"small"],[0.87,"o"],[0.97,"grin"],[1.045,"smile"],[1.12,"grin"],[1.195,"smile"],[1.32,"grin"],[1.395,"smile"],[1.47,"o"],[1.595,"grin"],[1.995,"small"],[2.07,"smile"],[2.195,"grin"],[2.62,"smile"],[2.77,"open"],[2.845,"smile"],[2.92,"grin"],[3.245,"o"],[3.345,"grin"],[3.57,"smile"],[3.645,"grin"],[3.745,"smile"],[3.845,"open"],[3.97,"grin"],[4.07,"small"],[4.195,"grin"],[4.57,"smile"],[4.77,"grin"],[5.045,"open"],[5.12,"small"],[5.22,"grin"],[5.37,"o"],[5.52,"small"],[5.595,"o"],[5.72,"grin"],[6.02,"smile"],[6.145,"open"],[6.295,"grin"],[6.575,"smile"],[7.17,"grin"],[7.67,"open"],[7.745,"smile"],[7.845,"grin"],[7.945,"smile"],[8.02,"grin"],[8.27,"o"],[8.37,"grin"],[8.47,"small"],[8.57,"open"],[8.77,"o"],[8.845,"grin"],[9.17,"o"],[9.395,"grin"],[9.445,