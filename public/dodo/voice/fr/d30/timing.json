23.815,"open"],[23.89,"smile"],[24.015,"grin"],[24.14,"smile"],[24.24,"grin"],[24.315,"smile"]]},"s5":{"file":"s5.mp3","dur":28.22,"text":"Le nuage glissa au-dessus d’une maison avec un jardin. Plic tomba dans un grand tonneau de pluie, près des tomates. Le lendemain, un petit garçon nommé Noé remplit son arrosoir, et Plic coula sur un tournesol. Puis Noé but un grand verre d’eau fraîche. Sa grand-mère lui raconta le voyage de l’eau : le nuage, la pluie, la rivière, la mer… « Waouh », dit Noé.","words":[0.12,0.375,0.875,1.725,2.2,2.4,2.8,3.05,3.175,4.29,4.715,5.14,5.365,5.49,5.79,6.09,6.265,6.84,7.09,7.24,8.44,8.705,9.605,9.755,10.13,10.655,11.08,11.355,11.805,12.03,13.18,13.355,13.73,14.13,14.305,14.43,15.88,16.18,16.455,16.755,16.88,17.155,17.43,17.63,18.74,19.065,19.715,19.89,20.415,20.54,21.015,21.19,21.79,21.79,21.965,22.89,23.115,23.515,23.665,24.19,24.34,25.79,25.79,26.9,26.9,27.325],"visemes":[[0.0,"smile"],[0.225,"grin"],[0.475,"o"],[0.55,"smile"],[0.65,"open"],[0.75,"grin"],[1.275,"smile"],[1.375,"open"],[1.625,"smile"],[1.75,"o"],[1.85,"grin"],[2.175,"o"],[2.325,"grin"],[2.425,"small"],[2.5,"grin"],[2.7,"o"],[2.825,"open"],[2.875,"grin"],[3.075,"o"],[3.2,"grin"],[3.3,"open"],[3.4,"grin"],[3.575,"smile"],[4.34,"small"],[4.415,"grin"],[4.79,"o"],[4.865,"smile"],[5.065,"open"],[5.315,"grin"],[5.39,"o"],[5.515,"grin"],[5.665,"open"],[5.815,"grin"],[5.89,"o"],[5.965,"grin"],[6.29,"small"],[6.365,"grin"],[6.44,"o"],[6.515,"smile"],[6.59,"grin"],[6.74,"smile"],[6.865,"small"],[6.94,"grin"],[7.34,"o"],[7.44,"small"],[7.515,"smile"],[7.615,"open"],[7.74,"grin"],[7.925,"smile"],[8.555,"grin"],[8.805,"open"],[8.88,"smile"],[8.955,"grin"],[9.055,"small"],[9.13,"smile"],[9.205,"grin"],[9.28,"smile"],[9.63,"o"],[9.78,"grin"],[10.23,"open"],[10.33,"grin"],[10.555,"o"],[10.68,"grin"],[10.755,"o"],[10.855,"small"],[10.955,"grin"],[11.155,"o"],[11.28,"grin"],[11.43,"open"],[11.505,"smile"],[11.58,"small"],[11.655,"grin"],[11.88,"o"],[11.98,"grin"],[12.055,"open"],[12.13,"g