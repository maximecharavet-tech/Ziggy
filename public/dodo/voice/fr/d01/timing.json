{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d01","segments":{"title":{"file":"title.mp3","dur":3.14,"text":"Le petit nuage qui voulait aider","words":[0.12,0.485,0.885,1.435,1.61,2.085],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.51,"small"],[0.585,"grin"],[0.985,"o"],[1.085,"smile"],[1.21,"open"],[1.31,"grin"],[1.635,"small"],[1.71,"o"],[1.785,"grin"],[2.31,"smile"],[2.41,"grin"],[2.665,"smile"]]},"s1":{"file":"s1.mp3","dur":27.29,"text":"Tout en haut du ciel, au-dessus d’une vallée tranquille, flotte un petit nuage blanc. Il s’appelle Plume. Il est rond, léger et tout doux, comme un oreiller de coton. Chaque jour, Plume se promène avec le vent. Il regarde les maisons, les rivières et les oiseaux. Et chaque jour, il se demande : « Moi aussi, est-ce que je peux aider quelqu’un ? »","words":[0.12,0.52,0.645,0.795,1.045,1.945,2.445,2.67,3.02,4.295,4.72,4.895,5.295,5.795,6.93,7.255,7.78,9.02,9.385,9.51,9.835,10.285,10.435,10.66,11.185,11.435,11.61,11.96,12.135,13.34,13.805,14.355,14.68,14.855,15.305,15.555,15.78,16.71,17.04,17.64,17.815,18.69,18.915,19.515,19.565,19.84,21.12,21.41,21.76,22.21,22.435,22.635,23.83,23.83,23.83,24.28,24.88,25.08,25.255,25.48,25.755,26.03,26.03,26.03],"visemes":[[0.0,"smile"],[0.22,"grin"],[0.295,"o"],[0.42,"grin"],[0.545,"open"],[0.72,"o"],[0.945,"smile"],[1.07,"grin"],[1.245,"smile"],[1.37,"grin"],[1.77,"smile"],[1.97,"o"],[2.07,"grin"],[2.395,"o"],[2.47,"grin"],[2.52,"o"],[2.595,"grin"],[2.695,"small"],[2.77,"open"],[2.845,"grin"],[3.195,"open"],[3.27,"smile"],[3.37,"grin"],[3.47,"smile"],[3.595,"grin"],[4.095,"smile"],[4.32,"small"],[4.445,"smile"],[4.52,"o"],[4.595,"grin"],[4.745,"o"],[4.92,"small"],[4.995,"grin"],[5.395,"o"],[5.47,"smile"],[5.57,"open"],[5.67,"grin"],[5.82,"small"],[5.945,"smile"],[6.02,"open"],[6.095,"smile"],[7.03,"grin"],[7.355,"open"],[7.43,"small"],[7.555,"grin"],[7.805,"small"],[7.88,"grin"],[7.955,"smile"],[8.03,"o"],[8.18,"small"],[8.505,"smile"],[9.16,"grin"],[9.585,"smile"],[9.66,"o"],[9.785,"smile"],[9.