{"v":2,"voice":"ziggy-v2","locale":"fr","story":"d01","segments":{"title":{"file":"title.mp3","dur":3.05,"text":"Le petit nuage qui voulait aider","words":[0.12,0.485,0.885,1.435,1.61,2.085],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.51,"small"],[0.585,"grin"],[0.985,"o"],[1.085,"smile"],[1.21,"open"],[1.31,"grin"],[1.635,"small"],[1.71,"o"],[1.785,"grin"],[2.31,"smile"],[2.41,"grin"],[2.575,"smile"]]},"s1":{"file":"s1.mp3","dur":25.87,"text":"Tout en haut du ciel, au-dessus d’une vallée tranquille, flotte un petit nuage blanc. Il s’appelle Plume. Il est rond, léger et tout doux, comme un oreiller de coton. Chaque jour, Plume se promène avec le vent. Il regarde les maisons, les rivières et les oiseaux. Et chaque jour, il se demande : « Moi aussi, est-ce que je peux aider quelqu’un ? »","words":[0.12,0.495,0.595,0.745,0.97,1.77,2.27,2.495,2.845,4.02,4.445,4.595,4.995,5.495,6.59,6.915,7.44,8.52,8.82,8.945,9.245,9.695,9.845,10.07,10.52,10.77,10.945,11.295,11.445,12.54,13.015,13.54,13.865,14.04,14.49,14.74,14.965,15.8,16.105,16.68,16.855,17.655,17.83,18.405,18.455,18.73,19.89,20.18,20.53,20.93,21.155,21.355,22.52,22.52,22.52,22.97,23.545,23.745,23.92,24.145,24.42,24.695,24.695,24.695],"visemes":[[0.0,"smile"],[0.195,"grin"],[0.27,"o"],[0.395,"grin"],[0.52,"open"],[0.67,"o"],[0.77,"grin"],[0.82,"o"],[0.995,"grin"],[1.17,"smile"],[1.295,"grin"],[1.62,"smile"],[1.795,"o"],[1.895,"grin"],[2.22,"o"],[2.42,"grin"],[2.52,"small"],[2.595,"open"],[2.67,"grin"],[3.02,"open"],[3.095,"smile"],[3.195,"grin"],[3.295,"smile"],[3.42,"grin"],[3.82,"smile"],[4.045,"small"],[4.17,"smile"],[4.245,"o"],[4.32,"grin"],[4.47,"o"],[4.62,"small"],[4.695,"grin"],[5.095,"o"],[5.17,"smile"],[5.27,"open"],[5.37,"grin"],[5.52,"small"],[5.645,"smile"],[5.72,"open"],[5.795,"smile"],[6.69,"grin"],[7.015,"open"],[7.09,"small"],[7.215,"grin"],[7.465,"small"],[7.54,"grin"],[7.615,"smile"],[7.69,"o"],[7.79,"small"],[8.005,"smile"],[8.645,"grin"],[9.02,"smile"],[9.095,"o"],[9.195,"smile"],[9.27,"grin"],[9.94