{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d17","segments":{"title":{"file":"title.mp3","dur":2.96,"text":"Le renard et l’écharpe d’hiver","words":[0.12,0.485,0.96,1.06,1.66],"visemes":[[0.0,"smile"],[0.285,"grin"],[0.735,"smile"],[0.81,"open"],[0.885,"grin"],[1.385,"open"],[1.46,"grin"],[1.535,"small"],[1.685,"grin"],[1.86,"small"],[1.96,"smile"],[2.135,"grin"],[2.485,"smile"]]},"s1":{"file":"s1.mp3","dur":28.04,"text":"Dans la forêt d’hiver, tout était blanc et silencieux. La neige couvrait les sapins comme une grosse couette. Là vivait Félix, un renard roux au museau pointu. Autour de son cou, il portait une longue écharpe verte à rayures jaunes. Sa grand-mère l’avait tricotée pour lui. Elle était douce, épaisse, et elle sentait bon la maison. Félix l’aimait beaucoup.","words":[0.12,0.42,0.645,0.995,1.895,2.17,2.495,2.795,2.945,4.45,4.805,5.28,5.73,5.955,6.53,6.755,6.93,7.33,8.44,8.74,9.065,10.09,10.215,10.665,10.915,11.015,11.365,12.61,13.135,13.335,13.635,14.285,14.485,14.935,15.085,15.385,16.01,16.31,16.385,16.81,17.93,18.28,18.955,19.23,19.88,20.13,21.11,21.375,21.7,22.2,23.3,23.45,23.675,24.1,24.225,24.4,25.74,26.44,26.84],"visemes":[[0.0,"smile"],[0.245,"grin"],[0.32,"open"],[0.445,"grin"],[0.52,"open"],[0.67,"small"],[0.745,"o"],[0.82,"grin"],[1.195,"small"],[1.27,"smile"],[1.42,"grin"],[1.77,"smile"],[1.92,"grin"],[1.995,"o"],[2.095,"grin"],[2.52,"small"],[2.595,"grin"],[2.695,"open"],[2.82,"grin"],[3.195,"open"],[3.295,"smile"],[3.42,"grin"],[3.62,"smile"],[3.695,"o"],[3.935,"smile"],[4.605,"grin"],[4.68,"open"],[4.83,"grin"],[4.905,"smile"],[5.005,"grin"],[5.38,"o"],[5.48,"small"],[5.555,"grin"],[6.08,"open"],[6.18,"small"],[6.255,"smile"],[6.33,"grin"],[6.63,"o"],[6.705,"small"],[6.78,"o"],[6.855,"grin"],[7.13,"o"],[7.205,"grin"],[7.43,"o"],[7.505,"smile"],[7.605,"grin"],[7.925,"smile"],[8.59,"grin"],[8.69,"open"],[8.765,"small"],[8.815,"grin"],[8.89,"small"],[8.965,"grin"],[9.09,"small"],[9.165,"grin"],[9.315,"smile"],[9.39,"grin"],[9.94,"smile"