t. Sans son écharpe, Félix sentait l’air froid lui chatouiller le cou. Il rentra dans son terrier et se roula en boule. Brrr. Il frissonnait un peu. Mais au fond de son cœur, il ne regrettait rien. Il pensait à Noisette, bien au chaud. Soudain, on frappa à la porte : toc, toc, toc.","words":[0.12,0.42,0.645,0.97,1.12,2.095,2.245,2.52,2.995,3.095,3.245,3.52,4.49,4.865,5.115,6.115,6.59,6.965,7.29,7.54,7.715,8.215,8.44,9.34,9.62,10.045,10.22,10.47,11.17,11.32,11.495,11.845,12.02,13.15,14.29,14.615,15.315,15.54,16.4,16.75,16.875,17.025,17.2,17.475,18.175,18.325,18.475,19.125,20.09,20.365,20.84,20.89,21.615,21.94,22.14,23.15,23.75,23.875,24.275,24.325,24.55,25.225,25.225,25.55,25.9],"visemes":[[0.0,"smile"],[0.245,"grin"],[0.82,"small"],[0.92,"grin"],[1.045,"o"],[1.145,"grin"],[1.445,"smile"],[1.595,"o"],[1.745,"grin"],[1.97,"smile"],[2.12,"grin"],[2.27,"small"],[2.37,"open"],[2.545,"grin"],[2.62,"o"],[2.745,"small"],[2.845,"grin"],[2.945,"open"],[3.02,"o"],[3.32,"grin"],[3.37,"smile"],[3.545,"small"],[3.62,"smile"],[3.77,"o"],[3.895,"grin"],[3.975,"smile"],[4.615,"grin"],[4.69,"open"],[4.89,"grin"],[4.965,"o"],[5.065,"grin"],[5.365,"smile"],[5.49,"open"],[5.59,"grin"],[5.69,"small"],[5.94,"smile"],[6.14,"grin"],[6.665,"open"],[6.74,"smile"],[6.815,"grin"],[7.04,"smile"],[7.115,"grin"],[7.315,"small"],[7.44,"o"],[7.64,"grin"],[7.815,"open"],[7.915,"grin"],[8.015,"o"],[8.09,"grin"],[8.54,"smile"],[8.615,"o"],[8.825,"smile"],[9.445,"grin"],[9.695,"open"],[9.77,"smile"],[9.845,"grin"],[10.12,"open"],[10.245,"grin"],[10.32,"o"],[10.495,"grin"],[10.845,"smile"],[10.92,"grin"],[11.595,"o"],[11.67,"grin"],[11.77,"open"],[12.045,"small"],[12.12,"smile"],[12.22,"o"],[12.345,"grin"],[12.515,"smile"],[13.26,"small"],[13.385,"grin"],[13.775,"smile"],[14.39,"grin"],[14.64,"small"],[14.715,"grin"],[14.99,"o"],[15.065,"grin"],[15.34,"o"],[15.565,"small"],[15.64,"smile"],[15.715,"o"],[15.885,"smile"],[16.525,"small"],[16.6,"grin"],[16.775,"o"],[16.9,"small"],[16.975,"o"],[17.05,"grin"],