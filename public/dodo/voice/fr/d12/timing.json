{"v":2,"voice":"ziggy-v2","locale":"fr","story":"d12","segments":{"title":{"file":"title.mp3","dur":2.38,"text":"Le jardin des abeilles","words":[0.12,0.475,0.975,1.225],"visemes":[[0.0,"smile"],[0.275,"grin"],[0.6,"open"],[0.7,"grin"],[1.25,"open"],[1.35,"small"],[1.45,"smile"],[1.6,"grin"],[1.905,"smile"]]},"s1":{"file":"s1.mp3","dur":27.45,"text":"Au bout d’une petite rue, il y avait une cour avec un vieux pommier. C’est là que vivait Amina, une petite fille aux cheveux bouclés, avec un ruban jaune. Le soir, Amina aimait s’asseoir sous le pommier. L’air sentait l’herbe tiède. Le ciel devenait rose, puis doré. Mais cette année, Amina remarqua une chose étrange : on n’entendait presque plus de bzzz.","words":[0.12,0.47,0.72,0.995,1.57,2.195,2.37,2.47,2.82,3.045,3.395,3.695,3.82,4.045,5.15,5.45,5.65,5.8,6.25,7.05,7.225,7.75,8.025,8.15,8.5,9.3,9.6,9.725,10.175,11.26,11.59,12.24,12.765,13.065,13.615,13.715,13.89,15.08,15.555,15.93,16.33,17.45,17.8,18.125,18.525,18.975,19.25,20.39,20.74,21.065,21.715,22.24,22.89,23.14,23.415,24.615,24.615,24.765,25.415,25.915,26.115,26.34],"visemes":[[0.0,"smile"],[0.27,"o"],[0.495,"small"],[0.62,"o"],[0.745,"grin"],[0.82,"o"],[0.895,"grin"],[1.02,"small"],[1.095,"grin"],[1.67,"smile"],[1.745,"o"],[2.02,"smile"],[2.22,"grin"],[2.495,"open"],[2.57,"small"],[2.67,"grin"],[2.845,"o"],[2.92,"grin"],[3.145,"smile"],[3.22,"o"],[3.32,"grin"],[3.42,"open"],[3.495,"grin"],[3.72,"o"],[3.845,"small"],[3.895,"o"],[4.07,"small"],[4.145,"o"],[4.245,"small"],[4.345,"grin"],[4.42,"smile"],[4.495,"grin"],[4.635,"smile"],[5.275,"grin"],[5.575,"open"],[5.675,"grin"],[5.825,"small"],[5.9,"grin"],[6.0,"small"],[6.1,"grin"],[6.275,"open"],[6.35,"small"],[6.425,"grin"],[6.6,"smile"],[6.7,"open"],[6.9,"smile"],[7.075,"o"],[7.15,"grin"],[7.25,"small"],[7.325,"grin"],[7.775,"small"],[7.825,"smile"],[7.9,"grin"],[8.05,"o"],[8.175,"grin"],[8.325,"small"],[8.425,"o"],[8.525,"small"],[8.6,"o"],[8.725,"grin"],[8.875,"smile"],[8.95,"grin"],[9.15,"smile"],[9.325,"open