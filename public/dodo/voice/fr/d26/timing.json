{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d26","segments":{"title":{"file":"title.mp3","dur":2.32,"text":"Le marchand de rêves","words":[0.12,0.445,0.97,1.195],"visemes":[[0.0,"smile"],[0.295,"grin"],[0.47,"small"],[0.545,"open"],[0.645,"grin"],[0.87,"open"],[0.995,"grin"],[1.295,"smile"],[1.445,"grin"],[1.62,"small"],[1.845,"smile"]]},"s1":{"file":"s1.mp3","dur":28.28,"text":"Dans une petite ville aux rues pavées, quand le soleil se couchait, on entendait une clochette. Ding, ding. C’était Sélim, le marchand de rêves. Il poussait une charrette de bois remplie de petits pots en verre. Dans chaque pot brillait un rêve : un rêve bleu, un rêve doré, un rêve couleur de fraise. Et tous les enfants couraient à leur fenêtre.","words":[0.12,0.57,0.795,1.37,1.845,1.995,2.22,2.945,3.12,3.32,3.82,4.045,4.92,5.145,5.77,5.97,7.41,8.01,9.23,9.81,10.66,10.835,11.31,11.51,12.6,12.89,13.465,13.69,14.415,14.565,14.79,15.24,15.415,15.815,16.065,16.265,17.28,17.705,18.055,18.255,18.83,19.03,19.955,19.955,20.13,20.48,20.955,21.13,21.48,22.205,22.405,22.755,23.205,23.405,24.81,25.135,25.335,25.585,26.085,26.485,26.535,26.835],"visemes":[[0.0,"smile"],[0.27,"grin"],[0.345,"open"],[0.42,"smile"],[0.495,"grin"],[0.595,"o"],[0.67,"grin"],[0.82,"small"],[0.895,"grin"],[1.395,"small"],[1.47,"smile"],[1.545,"grin"],[1.87,"o"],[2.02,"grin"],[2.12,"o"],[2.245,"small"],[2.345,"open"],[2.47,"small"],[2.545,"smile"],[2.62,"grin"],[2.795,"smile"],[2.97,"grin"],[3.045,"open"],[3.145,"grin"],[3.42,"o"],[3.495,"grin"],[3.57,"smile"],[3.645,"grin"],[4.145,"o"],[4.295,"grin"],[4.395,"smile"],[4.495,"grin"],[4.77,"smile"],[4.945,"o"],[5.07,"grin"],[5.17,"open"],[5.22,"smile"],[5.295,"grin"],[5.37,"open"],[5.445,"smile"],[5.52,"grin"],[5.795,"o"],[5.87,"grin"],[6.145,"o"],[6.27,"grin"],[6.37,"smile"],[6.47,"grin"],[6.775,"smile"],[7.56,"grin"],[7.635,"smile"],[7.71,"grin"],[7.91,"smile"],[8.035,"grin"],[8.11,"smile"],[8.235,"grin"],[8.715,"smile"],[9.385,"grin"],[10.11,"smile"],[10.21,"grin"],[10.36,