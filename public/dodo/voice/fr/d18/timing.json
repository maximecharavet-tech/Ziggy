. « Tu as de très grandes oreilles, Basile. Mais t’en sers-tu vraiment ? Pour aider un ami, il faut parfois se taire… et écouter. » Basile réfléchit. Il remua ses grandes oreilles. Puis il retourna voir Pic. Il s’assit à côté de lui, tout simplement. Et pour la première fois, il ne dit rien. Il attendit, gentiment.","words":[0.12,0.595,1.095,1.395,2.54,2.54,2.915,3.015,3.24,3.515,3.915,4.415,5.69,6.03,6.355,6.905,8.2,8.2,8.55,8.9,9.125,9.8,10.0,10.225,10.75,10.975,11.35,11.475,12.8,12.8,13.45,14.74,15.045,15.545,15.72,16.12,17.23,17.63,17.78,18.33,18.68,19.72,20.07,20.595,20.695,21.07,21.22,21.72,21.945,23.24,23.49,23.69,23.84,24.39,24.865,25.04,25.19,25.39,26.53,26.87,27.42],"visemes":[[0.0,"smile"],[0.245,"small"],[0.32,"open"],[0.395,"small"],[0.495,"grin"],[0.695,"o"],[0.77,"grin"],[0.995,"o"],[1.12,"grin"],[1.195,"o"],[1.27,"grin"],[1.47,"open"],[1.545,"smile"],[1.645,"grin"],[1.745,"small"],[1.82,"smile"],[2.715,"grin"],[2.79,"o"],[2.94,"open"],[3.04,"grin"],[3.715,"open"],[3.815,"grin"],[3.94,"o"],[4.015,"grin"],[4.09,"smile"],[4.165,"grin"],[4.315,"smile"],[4.44,"small"],[4.54,"open"],[4.665,"grin"],[4.765,"smile"],[4.89,"grin"],[5.175,"smile"],[5.83,"small"],[5.905,"grin"],[6.13,"open"],[6.38,"grin"],[6.78,"o"],[6.93,"small"],[7.005,"grin"],[7.205,"small"],[7.28,"smile"],[7.355,"open"],[7.43,"smile"],[8.275,"small"],[8.35,"o"],[8.45,"grin"],[8.925,"o"],[9.025,"grin"],[9.15,"open"],[9.25,"small"],[9.325,"smile"],[9.4,"grin"],[9.65,"smile"],[9.825,"grin"],[10.025,"small"],[10.1,"o"],[10.25,"small"],[10.325,"open"],[10.4,"grin"],[10.5,"small"],[10.575,"o"],[10.65,"open"],[10.775,"grin"],[11.075,"smile"],[11.175,"grin"],[11.3,"smile"],[11.375,"grin"],[11.7,"o"],[11.85,"grin"],[11.95,"smile"],[12.05,"grin"],[12.165,"smile"],[12.925,"small"],[13.025,"open"],[13.125,"grin"],[13.65,"small"],[13.725,"grin"],[14.05,"smile"],[14.125,"grin"],[14.225,"smile"],[14.845,"grin"],[15.22,"small"],[15.295,"o"],[15.37,"smile"],[15.445,"open"],[15.57,"grin"],[15.92,"open"],[16.0