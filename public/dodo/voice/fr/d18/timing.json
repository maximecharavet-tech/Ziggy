{"v":2,"voice":"ziggy-v3","locale":"fr","story":"d18","segments":{"title":{"file":"title.mp3","dur":2.75,"text":"Le lapin aux grandes oreilles","words":[0.12,0.445,0.87,0.995,1.445],"visemes":[[0.0,"smile"],[0.295,"grin"],[0.545,"open"],[0.645,"small"],[0.77,"grin"],[0.895,"o"],[1.02,"grin"],[1.195,"open"],[1.245,"smile"],[1.32,"grin"],[1.47,"o"],[1.57,"grin"],[1.67,"smile"],[1.82,"grin"],[2.275,"smile"]]},"s1":{"file":"s1.mp3","dur":28.32,"text":"Dans une prairie pleine de trèfles vivait Basile, un petit lapin gris et blanc. Basile avait les plus grandes oreilles de toute la prairie. Elles étaient longues, longues, avec un intérieur tout rose. Basile portait un petit gilet bleu. Et Basile adorait parler ! Il parlait le matin, il parlait à midi, il parlait le soir. Bla-bla-bla, du matin jusqu’au soir.","words":[0.12,0.535,0.735,1.285,1.66,1.86,2.385,2.685,3.885,4.085,4.485,4.935,5.26,5.41,6.42,7.1,7.275,7.45,7.675,8.325,8.75,8.95,9.175,9.325,10.49,10.84,11.09,11.59,12.49,12.765,12.89,13.54,13.765,14.91,15.61,16.085,16.21,16.61,16.985,17.95,18.175,18.625,18.95,20.13,20.13,20.43,20.78,20.905,21.63,21.805,22.255,22.33,23.03,23.205,23.555,23.78,25.02,26.12,26.245,26.645,27.12],"visemes":[[0.0,"smile"],[0.235,"grin"],[0.31,"open"],[0.385,"smile"],[0.46,"grin"],[0.56,"o"],[0.635,"grin"],[0.76,"small"],[0.835,"grin"],[1.31,"small"],[1.435,"smile"],[1.51,"grin"],[2.01,"smile"],[2.085,"grin"],[2.185,"small"],[2.285,"grin"],[2.41,"small"],[2.485,"grin"],[2.56,"small"],[2.635,"grin"],[2.71,"small"],[2.81,"open"],[2.96,"grin"],[3.035,"smile"],[3.16,"grin"],[3.71,"smile"],[3.91,"o"],[4.11,"small"],[4.185,"grin"],[4.585,"open"],[4.685,"small"],[4.81,"grin"],[5.435,"small"],[5.56,"smile"],[5.635,"open"],[5.71,"smile"],[6.525,"small"],[6.625,"open"],[6.725,"grin"],[6.8,"smile"],[6.875,"grin"],[7.175,"small"],[7.25,"grin"],[7.475,"small"],[7.525,"o"],[7.7,"grin"],[7.825,"smile"],[7.9,"open"],[7.975,"smile"],[8.05,"grin"],[8.35,"o"],[8.45,"grin"],[8.525,"smile"],[8.6,"grin"],[9.05,"o