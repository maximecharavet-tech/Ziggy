{"v":2,"voice":"ziggy-v2","locale":"fr","story":"d27","segments":{"title":{"file":"title.mp3","dur":3.52,"text":"La petite sirène et le grand plongeon","words":[0.12,0.45,1.0,1.75,1.85,2.0,2.325],"visemes":[[0.0,"smile"],[0.25,"grin"],[0.325,"open"],[0.475,"small"],[0.55,"grin"],[1.275,"smile"],[1.375,"grin"],[2.2,"open"],[2.35,"small"],[2.425,"grin"],[2.5,"o"],[2.575,"smile"],[2.675,"grin"],[2.75,"smile"],[2.825,"o"],[2.9,"smile"]]},"s1":{"file":"s1.mp3","dur":23.54,"text":"Au fond de la mer bleue, près d’un récif de corail rose, vivait une petite sirène nommée Maïa. Elle avait une queue couleur turquoise et des cheveux bouclés pleins de bulles. Maïa aimait nager près de la surface, là où la lumière dansait. Mais le grand trou bleu, tout au fond, lui faisait un peu peur. Elle n’y allait jamais.","words":[0.12,0.45,0.675,0.775,0.975,1.325,1.9,2.15,2.4,2.9,3.075,3.625,4.55,5.025,5.25,5.8,6.3,6.65,7.63,7.895,8.195,8.395,8.645,9.145,10.045,10.145,10.345,10.745,11.195,11.37,11.545,12.58,13.095,13.345,13.795,13.945,14.02,14.195,15.345,15.545,15.645,15.77,16.195,17.29,17.565,17.715,18.015,18.265,18.665,18.915,19.09,19.59,19.79,20.24,20.365,20.615,21.77,22.095,22.27,22.595],"visemes":[[0.0,"smile"],[0.25,"o"],[0.35,"smile"],[0.475,"small"],[0.575,"o"],[0.7,"grin"],[0.875,"open"],[1.0,"small"],[1.05,"smile"],[1.125,"grin"],[1.35,"small"],[1.425,"grin"],[1.475,"smile"],[1.575,"o"],[1.75,"smile"],[1.925,"small"],[2.0,"grin"],[2.25,"o"],[2.425,"grin"],[2.825,"small"],[2.925,"grin"],[3.175,"o"],[3.275,"grin"],[3.35,"smile"],[3.425,"open"],[3.5,"grin"],[3.725,"smile"],[3.875,"o"],[4.025,"grin"],[4.375,"smile"],[4.575,"small"],[4.65,"grin"],[4.75,"small"],[4.875,"grin"],[5.05,"o"],[5.125,"grin"],[5.275,"small"],[5.35,"grin"],[6.075,"smile"],[6.15,"grin"],[6.4,"o"],[6.475,"small"],[6.575,"grin"],[6.675,"small"],[6.75,"open"],[6.875,"grin"],[6.95,"smile"],[7.025,"open"],[7.115,"smile"],[7.745,"grin"],[7.92,"open"],[7.97,"small"],[8.07,"grin"],[8.22,"o"],[8.295,"grin"],[8.52,"o"],[8