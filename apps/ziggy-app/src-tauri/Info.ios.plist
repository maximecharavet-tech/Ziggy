<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by the Tauri CLI into gen/apple/<app>_iOS/Info.plist at every iOS build. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Ziggy AI</string>
	<!-- Bedtime stories keep playing with the screen locked (AVAudioSession .playback, lib.rs). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The app sets the status bar style itself, from the page under it (set_bar_style). -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<!-- iPhone: portrait and landscape (games); iPad: every orientation, multitasking allowed. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- The photo picker of the avatar page (parents only, with consent) offers "Take Photo".
	     No microphone key: voice input is switched off in the app (shell.js). -->
	<key>NSCameraUsageDescription</key>
	<string>Un adulte peut prendre une photo pour créer l'avatar de l'enfant ; elle n'est jamais enregistrée. / A grown-up can take a photo to create the child's avatar; it is never stored.</string>
	<!-- Only standard HTTPS: exempt from export compliance paperwork. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
