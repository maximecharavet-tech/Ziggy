<?xml version="1.0" encoding="utf-8"?>
<!-- Window background: the site's background colour with Ziggy in the middle, exactly
     where the Android 12+ splash icon and the bundled launch page draw him, so the
     launch is one continuous picture (no white flash). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:opacity="opaque">
    <item android:drawable="@color/ziggy_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/splash_ziggy" />
</layer-list>
