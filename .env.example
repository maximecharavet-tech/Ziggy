# ── Ziggy's AI brain ───────────────────────────────────────────────
# Set ONE of these. They are tried in this order.
# Leave them all empty and the site still runs — only the chat naps.

# 1. Google Gemini — free, no credit card. Get a key in ~1 minute at
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq — free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# 3. Anthropic Claude — paid. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Site ───────────────────────────────────────────────────────────
# Used for the sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
