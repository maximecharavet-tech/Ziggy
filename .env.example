# ── Accounts & database (Supabase) ─────────────────────────────────
# Project settings → API. The publishable key is safe in the browser:
# every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Ziggy's AI brain ───────────────────────────────────────────────
# Set ONE of these. They are tried in this order.
# Leave them all empty and the site still runs — only the chat naps.

# 1. Google Gemini — free, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq — free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# 3. Anthropic Claude — paid. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Site ───────────────────────────────────────────────────────────
# Canonical domain for the sitemap, Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL=https://ziggy-ai.fr
