# ── Accounts & database (Supabase) ─────────────────────────────────
# Project settings → API. The publishable key is safe in the browser:
# every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Ziggy's AI brain ───────────────────────────────────────────────
# Set ONE of these. They are tried in this order.
# Leave them all empty and the site still runs — only the chat naps.

# 1. Google Gemini — free, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. DeepSeek — https://platform.deepseek.com (also powers Ziggy World, below)
# 3. NVIDIA NIM — https://build.nvidia.com (also powers Ziggy World, below)

# 4. Groq — free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=

# 5. Anthropic Claude — paid. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Ziggy World · Hyper Engine (server only, never exposed to the browser) ──
# Without these keys Ziggy World still works fully with local content;
# AI only enriches quests, stories, game questions and avatars.

# Text brain (quests, stories, Game Factory JSON). Tried first.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Vision (photo → avatar colours, in memory only), content safety second
# opinion for ChildShield, and text fallback.
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
# Mode dodo illustrations (generated once by the owner from /dodo).
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_IMAGE_EDIT_MODEL=black-forest-labs/flux.1-kontext-dev

# Avatar and world illustrations (receives text prompts only, never a photo).
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# Optional: a standalone Hyper Engine service (https only). When set, Ziggy
# calls it server-to-server and still re-validates every answer; otherwise
# the orchestrator runs inside Ziggy.
HYPER_ENGINE_API_URL=
HYPER_ENGINE_API_KEY=

# CostGuard limits (per parent account, and for the whole platform).
ZIGGY_DAILY_GENERATION_LIMIT=25
ZIGGY_MONTHLY_GENERATION_LIMIT=300
ZIGGY_DAILY_IMAGE_LIMIT=4
ZIGGY_PLATFORM_MONTHLY_LIMIT=5000

# ── Site ───────────────────────────────────────────────────────────
# Canonical domain for the sitemap, Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL=https://ziggy-ai.fr
